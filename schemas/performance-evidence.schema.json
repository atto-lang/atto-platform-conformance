{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ores-truffle-oreslang.github.io/schemas/performance-evidence-v1.schema.json",
  "title": "Oreslang structural benchmark evidence v1 — NOT execution attestation",
  "description": "Schema validates report structure only. A passing report never independently proves that benchmarks, hardware, or toolchain executions occurred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "family",
    "backend",
    "mode",
    "sourceSha",
    "compilerSha256",
    "fixtureSha256",
    "toolchain",
    "environment",
    "kind",
    "unit",
    "samples",
    "correctness",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "UNCONFIGURED",
        "UNSUPPORTED",
        "FAIL",
        "NOT_VECTORIZED",
        "SIMULATED_ONLY",
        "SYNTH_ONLY",
        "PLACE_ROUTE_VERIFIED",
        "MEASURED"
      ]
    },
    "family": {
      "enum": [
        "software",
        "fpga",
        "asic"
      ]
    },
    "backend": {
      "enum": [
        "java",
        "llvm",
        "wasm",
        "fpga",
        "asic"
      ]
    },
    "mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "compilerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "cpu",
        "clockPolicy"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "cpu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "clockPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "kind": {
      "enum": [
        "latency",
        "throughput",
        "allocation",
        "build_time",
        "image_size",
        "ii",
        "fmax",
        "lut",
        "ff",
        "bram",
        "dsp",
        "area",
        "slack",
        "critical_path",
        "power"
      ]
    },
    "unit": {
      "enum": [
        "ns",
        "ops/s",
        "bytes/op",
        "ms",
        "bytes",
        "cycles",
        "MHz",
        "count",
        "um2",
        "mW"
      ]
    },
    "samples": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "number"
      }
    },
    "correctness": {
      "enum": [
        "UNVERIFIED",
        "PASS",
        "FAIL"
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "sha256",
          "locator"
        ],
        "properties": {
          "stage": {
            "enum": [
              "compile",
              "test",
              "simulation",
              "synthesis",
              "place-route",
              "board",
              "power-model",
              "correctness",
              "benchmark"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "software"
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "enum": [
              "java",
              "llvm",
              "wasm"
            ]
          },
          "kind": {
            "enum": [
              "latency",
              "throughput",
              "allocation",
              "build_time",
              "image_size"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "fpga"
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "enum": [
              "fpga"
            ]
          },
          "kind": {
            "enum": [
              "ii",
              "fmax",
              "lut",
              "ff",
              "bram",
              "dsp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "asic"
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "enum": [
              "asic"
            ]
          },
          "kind": {
            "enum": [
              "area",
              "slack",
              "critical_path",
              "power"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "latency"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ns"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "throughput"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ops/s"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "allocation"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "bytes/op"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "build_time"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ms"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image_size"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "bytes"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ii"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "cycles"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fmax"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "MHz"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lut"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "count"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ff"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "count"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bram"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "count"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dsp"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "count"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "area"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "um2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "slack"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ns"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "critical_path"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ns"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "power"
          }
        }
      },
      "then": {
        "properties": {
          "unit": {
            "const": "mW"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "MEASURED"
          }
        }
      },
      "then": {
        "properties": {
          "family": {
            "enum": [
              "software",
              "fpga"
            ]
          },
          "samples": {
            "minItems": 5
          },
          "correctness": {
            "const": "PASS"
          },
          "evidence": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SIMULATED_ONLY",
              "SYNTH_ONLY"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "family": {
            "enum": [
              "fpga",
              "asic"
            ]
          },
          "samples": {
            "minItems": 1
          },
          "correctness": {
            "const": "PASS"
          },
          "evidence": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PLACE_ROUTE_VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "family": {
            "const": "fpga"
          },
          "samples": {
            "minItems": 1
          },
          "correctness": {
            "const": "PASS"
          },
          "evidence": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "UNCONFIGURED",
              "UNSUPPORTED",
              "FAIL",
              "NOT_VECTORIZED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "samples": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          },
          "correctness": {
            "enum": [
              "UNVERIFIED",
              "FAIL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "MEASURED",
              "SYNTH_ONLY",
              "PLACE_ROUTE_VERIFIED",
              "SIMULATED_ONLY"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "correctness"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "MEASURED"
          },
          "family": {
            "const": "software"
          }
        },
        "required": [
          "status",
          "family"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "benchmark"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "MEASURED"
          },
          "family": {
            "const": "fpga"
          }
        },
        "required": [
          "status",
          "family"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "benchmark"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "MEASURED"
          },
          "family": {
            "const": "fpga"
          }
        },
        "required": [
          "status",
          "family"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "place-route"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "MEASURED"
          },
          "family": {
            "const": "fpga"
          }
        },
        "required": [
          "status",
          "family"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "board"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SYNTH_ONLY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "synthesis"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SIMULATED_ONLY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "simulation"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PLACE_ROUTE_VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "place-route"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "MEASURED",
              "SYNTH_ONLY",
              "PLACE_ROUTE_VERIFIED",
              "SIMULATED_ONLY"
            ]
          },
          "family": {
            "const": "asic"
          },
          "kind": {
            "const": "power"
          }
        },
        "required": [
          "status",
          "family",
          "kind"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "stage": {
                  "const": "power-model"
                }
              },
              "required": [
                "stage"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "latency",
              "throughput",
              "allocation",
              "build_time",
              "image_size",
              "fmax",
              "area",
              "critical_path",
              "power"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "lut",
              "ff",
              "bram",
              "dsp"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ii"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "samples": {
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "MEASURED",
              "SYNTH_ONLY",
              "PLACE_ROUTE_VERIFIED",
              "SIMULATED_ONLY"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sourceSha": {
            "type": "string",
            "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
          },
          "compilerSha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
          },
          "fixtureSha256": {
            "type": "string",
            "pattern": "^(?!0{64}$)[a-f0-9]{64}$"
          },
          "toolchain": {
            "properties": {
              "version": {
                "not": {
                  "const": "unconfigured"
                }
              }
            }
          },
          "environment": {
            "properties": {
              "target": {
                "not": {
                  "const": "unknown"
                }
              },
              "cpu": {
                "not": {
                  "const": "unknown"
                }
              },
              "clockPolicy": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          }
        }
      }
    }
  ]
}
