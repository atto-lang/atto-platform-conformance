// CANDIDATE real channel guest: exactly-one-winner left-first admission.
// No source-free JavaScript simulation may be accepted as this fixture's result.
pub fnc main(): void {
  let Channel<int> left = Channel.new<int>(2);
  let Channel<int> right = Channel.new<int>(2);
  writech left, 10;
  writech right, 20;
  let SelectPlan plan = SelectPlan.from_list([
    SelectCase.read(left), SelectCase.read(right)
  ]);
  let Option<SelectResult> first = try select fair from plan;
  stdio.stdout.write(first.unwrap().index);
  stdio.stdout.write(":");
  stdio.stdout.write(first.unwrap().value);
  return;
}
