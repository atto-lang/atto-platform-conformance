// CANDIDATE guest fixture; no backend execution certified.
// Actor-owned mail -> reply; guest stdout must be exactly "42".
// Update this file only with a new Git blob pin and semantic review.
define actor Echo as
  receive(ActorMail<int> mail): void {
    self.send(mail.value + 1);
    self.end();
    return;
  }
end

pub suspends fnc main(): void {
  let worker = spawn Echo();
  await worker.get_ready();
  worker.send(41);
  let reply = (await worker.outputs.next()).value.unwrap();
  stdio.stdout.write(reply.value);
  await worker.get_done();
  return;
}
