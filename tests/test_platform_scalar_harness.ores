// Pure Oreslang scalar reference models; these do not call platform native APIs.
import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, run_suite, require_success from "ores.std/testing";

fnc choose_sign(int value): int {
  if value > 0; do
    return 1;
  else
    return -1;
  fi
}

fnc integer_precedence(): TestOutcome {
  return expect_true(1 + 3 * 4 == 13 && (1 + 3) * 4 == 16, "integer_precedence reference assertion failed");
}
fnc explicit_branch_returns(): TestOutcome {
  return expect_true(choose_sign(8) == 1 && choose_sign(0) == -1, "explicit_branch_returns reference assertion failed");
}
fnc signed_comparison_and_bool_logic(): TestOutcome {
  return expect_true((-7 < 0) && !(7 < 0) && (7 >= 7), "signed_comparison_and_bool_logic reference assertion failed");
}
pub routine main(): void {
  val TestSuite suite = new TestSuite("platform-scalar-conformance", arr[
    new TestCase("integer_precedence", integer_precedence, false, ""),
    new TestCase("explicit_branch_returns", explicit_branch_returns, false, ""),
    new TestCase("signed_comparison_and_bool_logic", signed_comparison_and_bool_logic, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
