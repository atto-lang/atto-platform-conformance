{
  "name": "@oreslang/platform-conformance",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "inspect": "node bin/conformance.mjs",
    "check:integration": "node bin/check-org-integration.mjs",
    "check:compatibility": "node bin/check-compatibility-release.mjs",
    "gate:release": "node bin/check-compatibility-release.mjs --require-ready",
    "audit:pin-provenance": "node bin/audit-compatibility-pins.mjs",
    "check:head-snapshot": "node bin/check-head-snapshot.mjs",
    "check:ml-source-lock": "node bin/check-ml-source-lock.mjs"
  }
}
