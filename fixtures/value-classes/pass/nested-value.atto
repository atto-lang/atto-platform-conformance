define value class Point as
    pub final int x;
    pub final int y;
    constructor(int x, int y) {
        self.x = x;
        self.y = y;
    }
end
define value class PairOfPoints as
    pub final Point first;
    pub final Point second;
    constructor(Point first, Point second) {
        self.first = first;
        self.second = second;
    }
end
pub fnc main(): int {
    val PairOfPoints a = PairOfPoints(Point(1, 2), Point(3, 4));
    val PairOfPoints b = PairOfPoints(Point(1, 2), Point(3, 4));
    if a eq b then return 42; else return 0; fi
}
