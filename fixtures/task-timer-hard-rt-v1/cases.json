      "kind": "runtime_race",
      "events": [
        "task_acquires_guard",
        "task_suspends_on_timer",
        "cancel_scope",
        "task_terminal_published",
        "cleanup_releases_guard",
        "physical_retirement"
      ],
      "expected": {
        "guard_release_count": 1,
        "scope_drained_before_physical_retirement": false
      }
    },
    {
      "id": "deadline_inheritance",
      "kind": "runtime_race",
      "events": [
        "parent_deadline(100)",
        "child_deadline(200)",
        "task_timer_register"
      ],
      "expected": {
        "effective_deadline": 100,
        "clock": "monotonic_absolute"
      }
    },
    {
