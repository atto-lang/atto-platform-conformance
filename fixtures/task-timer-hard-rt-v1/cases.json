  "cases": [
    {
      "id": "task_sleep_reuses_own_continuation",
      "kind": "source_candidate",
      "source": "pub async fnc main(): int { let Task<int> t = task { await time.sleep(1ms); return 42; }; return await t; }",
      "expected": {
        "result": 42,
        "extra_implicit_tasks": 0,
        "task_scope_owned": true
      }
    },
    {
      "id": "task_zero_sleep_queues_next_turn",
      "kind": "source_candidate",
      "source": "pub async fnc main(): int { let Task<int> t = task { await time.sleep(0ns); return 7; }; return await t; }",
      "expected": {
        "result": 7,
        "min_resume_turns": 1,
        "carrier_sleep_calls": 0
      }
    },
    {
      "id": "task_cancel_expiry_single_winner",
      "kind": "runtime_race",
      "events": [
        "register(owner=task1,gen=4)",
        "concurrent(cancel_task1,expire)",
        "scope_join"
      ],
      "expected": {
        "timer_slot_releases": 1,
        "continuation_resume_count_max": 1,
        "physical_retirement_before_scope_join": true
      }
    },
    {
