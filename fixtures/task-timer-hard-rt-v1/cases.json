{
  "contract": "task-timers-hard-rt-v1",
  "status": "candidate-unverified",
  "generatedDate": "2026-11-10",
  "backends": [
    "java",
    "llvm",
    "net",
    "wasm",
    "forge",
    "rs",
    "cranelift",
    "js",
    "hdl",
    "atto",
