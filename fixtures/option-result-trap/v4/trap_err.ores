// ORT4-TRAP_ERR: Some(Err) is data; never None.
trap fnc checked(): Result<int, String> { return Err("typed-error"); }
pub fnc main(): int {
  val Option<Result<int, String>> outer = checked();
  if outer.is_none(); then return 1; fi
  val Result<int, String> inner = outer.unwrap();
  if inner.is_ok(); then return 2; fi
  if inner.unwrap_or(19) == 19; then return 0; fi
  return 3;
}
