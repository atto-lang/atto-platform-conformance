// ORT4-TRAP_EXPR_ERR: trap expression wraps Err in Some.
fnc checked(): Result<int, String> { return Err("typed-error"); }
pub fnc main(): int {
  val Option<Result<int, String>> outer = trap checked();
  if outer.is_none(); then return 1; fi
  if outer.unwrap().is_err(); then return 0; fi
  return 2;
}
