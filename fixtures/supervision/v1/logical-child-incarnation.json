{
  "schemaVersion": 1,
  "scope": "host-supervisor-logical-child-identity",
  "sourceGuestExecution": "unimplemented",
  "note": "Host-only cross-backend contract. Trusted spawn/finalization identity wiring and acknowledged STOP are implemented in draft runtimes, not full guest execution or durable restart.",
  "scenarios": [
    {
      "id": "first-generation",
      "input": [
        "register(actor-A)"
      ],
      "expected": {
        "logicalIncarnation": 1,
        "phase": "ACTIVE"
      }
    },
    {
      "id": "must-finalize-first",
      "input": [
        "register(actor-A)",
        "replace(actor-A,1,actor-B)"
      ],
      "expected": "reject-not-finalized"
    },
    {
      "id": "replacement",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(actor-A,1)",
        "spawn-and-admit(actor-B)",
        "commit-reservation(actor-B)"
      ],
      "expected": {
        "sameLogicalChildId": true,
        "actor": "actor-B",
        "logicalIncarnation": 2,
        "phase": "ACTIVE"
      }
    },
    {
      "id": "stale-finalizer",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "replace(actor-A,1,actor-B)",
        "finalize(actor-A,1)"
      ],
      "expected": "reject-stale-incarnation"
    },
    {
      "id": "stale-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "replace(actor-A,1,actor-B)",
        "stop(actor-A,1)"
      ],
      "expected": "reject-stale-incarnation"
    },
    {
      "id": "exactly-one-restart-winner",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "race-begin-restart(actor-A,1)"
      ],
      "expected": {
        "acceptedReservations": 1,
        "rejectedReservations": 1,
        "phase": "RESTARTING"
      }
    },
    {
      "id": "stop-and-retire",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "stop(actor-A,1)",
        "retire"
      ],
      "expected": {
        "trackedChildren": 0,
        "staleKey": "reject"
      }
    },
    {
      "id": "cross-registry-aba",
      "input": [
        "register-child-owner-1",
        "recreate-registry-same-owner",
        "register-another-child"
      ],
      "expected": {
        "distinctLogicalIds": true,
        "staleKey": "reject"
      }
    },
    {
      "id": "no-stop-during-restart",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(actor-A,1)",
        "stop(actor-A,1)"
      ],
      "expected": "reject-active-reservation"
    },
    {
      "id": "abort-and-retry",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(A) as permit1",
        "abort(permit1)",
        "reserve-restart(A) as permit2",
        "commit(permit1,actor-B)"
      ],
      "expected": "reject-stale-permit"
    },
    {
      "id": "failed-spawn-rollback",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(A)",
        "spawn-fails",
        "abort-reservation"
      ],
      "expected": {
        "phase": "FINALIZED",
        "logicalIncarnation": 1
      }
    },
    {
      "id": "actor-aba",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve",
        "commit(actor-B)",
        "finalize(actor-B,2)",
        "reserve",
        "commit(actor-A)"
      ],
      "expected": "reject-reused-physical-actor"
    },
    {
      "id": "native-slot-high-water",
      "input": [
        "register(native-slot-2-generation-5)",
        "finalize",
        "register(native-slot-2-generation-5)"
      ],
      "expected": "reject-reused-scheduler-generation"
    },
    {
      "id": "native-live-slot-collision",
      "input": [
        "register(native-slot-2-generation-5)",
        "register(native-slot-2-generation-6)"
      ],
      "expected": "reject-concurrent-slot-incarnation"
    },
    {
      "id": "host-acknowledged-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "publish-typed-failure(actor-A,1)",
        "host-acknowledges-stop(turn-7)",
        "commit-stop(actor-A,1)"
      ],
      "expected": {
        "phase": "STOPPED",
        "actor": "actor-A",
        "logicalIncarnation": 1
      }
    },
    {
      "id": "ambiguous-host-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "publish-typed-failure(actor-A,1)",
        "host-stop-sink-throws"
      ],
      "expected": {
        "phase": "FINALIZED",
        "resolved": 0,
        "automaticRetry": false
      }
    },
    {
      "id": "duplicate-host-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "host-acknowledges-stop(turn-7)",
        "commit-stop(actor-A,1)",
        "commit-stop(actor-A,1)"
      ],
      "expected": "reject-replayed-terminal-decision"
    },
    {
      "id": "physical-actor-forgery",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "host-acknowledges-stop(turn-7)",
        "commit-stop(actor-B,1)"
      ],
      "expected": "reject-wrong-physical-incarnation"
    },
    {
      "id": "normal-exit-retirement",
      "input": [
        "register(actor-A)",
        "seal-physical-normal-exit(actor-A)",
        "finalize(actor-A,1)",
        "stop(actor-A,1)",
        "retire"
      ],
      "expected": {
        "trackedChildren": 0,
        "terminalPanicAllowed": false
      }
    },
    {
      "id": "stop-pre-reserves-generation",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-stop(actor-A,1,turn-17)",
        "race-begin-restart(actor-A,1)"
      ],
      "expected": {
        "phase": "STOPPING",
        "restart": "reject-concurrent-reservation",
        "committedStop": false
      }
    },
    {
      "id": "ambiguous-stop-quarantine",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-stop(actor-A,1,turn-17)",
        "host-stop-effect-throws"
      ],
      "expected": {
        "phase": "STOPPING",
        "resolved": 0,
        "automaticRetry": false,
        "restart": "reject-until-explicit-reconciliation"
      }
    },
    {
      "id": "acknowledged-reserved-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-stop(actor-A,1,turn-17)",
        "host-stop-acknowledged",
        "commit-stop(actor-A,1,turn-17)"
      ],
      "expected": {
        "phase": "STOPPED",
        "logicalIncarnation": 1
      }
    },
    {
      "id": "stop-turn-replay-denied",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-stop(actor-A,1,turn-17)",
        "commit-stop(actor-A,1,turn-18)"
      ],
      "expected": "reject-wrong-stop-turn"
    },
    {
      "id": "stop-restart-race",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "race-reserve-stop-and-restart(actor-A,1)"
      ],
      "expected": {
        "acceptedReservations": 1,
        "rejectedReservations": 1
      }
    }
  ],
  "description": "Host lifecycle transitions include STOPPING single-flight STOP reservation, keyed to exact generation and supervisor CONTROL turn. Ambiguous host effects remain quarantined until explicit reconciliation.",
  "phases": [
    "ACTIVE",
    "FINALIZED",
    "RESTARTING",
    "STOPPING",
    "STOPPED"
  ]
}
