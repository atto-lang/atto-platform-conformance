{
  "schemaVersion": 1,
  "scope": "host-supervisor-logical-child-identity",
  "sourceGuestExecution": "unimplemented",
  "note": "Host-only model. Actor finalization/spawn and lifecycle effect authority are external to the registry.",
  "scenarios": [
    {
      "id": "first-generation",
      "input": [
        "register(actor-A)"
      ],
      "expected": {
        "logicalIncarnation": 1,
        "phase": "ACTIVE"
      }
    },
    {
      "id": "must-finalize-first",
      "input": [
        "register(actor-A)",
        "replace(actor-A,1,actor-B)"
      ],
      "expected": "reject-not-finalized"
    },
    {
      "id": "replacement",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(actor-A,1)",
        "spawn-and-admit(actor-B)",
        "commit-reservation(actor-B)"
      ],
      "expected": {
        "sameLogicalChildId": true,
        "actor": "actor-B",
        "logicalIncarnation": 2,
        "phase": "ACTIVE"
      }
    },
    {
      "id": "stale-finalizer",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "replace(actor-A,1,actor-B)",
        "finalize(actor-A,1)"
      ],
      "expected": "reject-stale-incarnation"
    },
    {
      "id": "stale-stop",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "replace(actor-A,1,actor-B)",
        "stop(actor-A,1)"
      ],
      "expected": "reject-stale-incarnation"
    },
    {
      "id": "exactly-one-restart-winner",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "race-begin-restart(actor-A,1)"
      ],
      "expected": {
        "acceptedReservations": 1,
        "rejectedReservations": 1,
        "phase": "RESTARTING"
      }
    },
    {
      "id": "stop-and-retire",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "stop(actor-A,1)",
        "retire"
      ],
      "expected": {
        "trackedChildren": 0,
        "staleKey": "reject"
      }
    },
    {
      "id": "cross-registry-aba",
      "input": [
        "register-child-owner-1",
        "recreate-registry-same-owner",
        "register-another-child"
      ],
      "expected": {
        "distinctLogicalIds": true,
        "staleKey": "reject"
      }
    },
    {
      "id": "no-stop-during-restart",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(actor-A,1)",
        "stop(actor-A,1)"
      ],
      "expected": "reject-active-reservation"
    },
    {
      "id": "abort-and-retry",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(A) as permit1",
        "abort(permit1)",
        "reserve-restart(A) as permit2",
        "commit(permit1,actor-B)"
      ],
      "expected": "reject-stale-permit"
    },
    {
      "id": "failed-spawn-rollback",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve-restart(A)",
        "spawn-fails",
        "abort-reservation"
      ],
      "expected": {
        "phase": "FINALIZED",
        "logicalIncarnation": 1
      }
    },
    {
      "id": "actor-aba",
      "input": [
        "register(actor-A)",
        "finalize(actor-A,1)",
        "reserve",
        "commit(actor-B)",
        "finalize(actor-B,2)",
        "reserve",
        "commit(actor-A)"
      ],
      "expected": "reject-reused-physical-actor"
    },
    {
      "id": "native-slot-high-water",
      "input": [
        "register(native-slot-2-generation-5)",
        "finalize",
        "register(native-slot-2-generation-5)"
      ],
      "expected": "reject-reused-scheduler-generation"
    },
    {
      "id": "native-live-slot-collision",
      "input": [
        "register(native-slot-2-generation-5)",
        "register(native-slot-2-generation-6)"
      ],
      "expected": "reject-concurrent-slot-incarnation"
    }
  ],
  "description": "Host-only lifecycle protocol reserves the finalized child generation before any spawn, with abort/commit fencing",
  "phases": [
    "ACTIVE",
    "FINALIZED",
    "RESTARTING",
    "STOPPED"
  ]
}
