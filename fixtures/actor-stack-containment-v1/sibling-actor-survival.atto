// PENDING compiler-backed actor-stack acceptance fixture, NOT execution proof.
// A must fault in the guest-frame budget; B must still execute on the carrier.
// The eventual harness must independently observe A's typed terminal outcome,
// B's response, process survival and supervisor generation/restart.
fnc non_tail_overflow(int remaining): int {
  if remaining == 0; do
    return 0;
  else
    return 1 + non_tail_overflow(remaining - 1);
  fi
}

define actor OverflowActor as
  receive(ActorMail<int> mail): void {
    val result = non_tail_overflow(100000);
    self.send(result);
    self.end();
    return;
  }
end

define actor HealthyActor as
  receive(ActorMail<int> mail): void {
    self.send(mail.value + 1);
    self.end();
    return;
  }
end

pub suspends routine main(): void {
  val failing = spawn OverflowActor();
  val healthy = spawn HealthyActor();
  await failing.get_ready();
  await healthy.get_ready();
  failing.send(1);
  healthy.send(41);
  val reply = (await healthy.outputs.next()).value.unwrap();
  stdio.stdout.write(reply.value);
  await healthy.get_done();
  return;
}
