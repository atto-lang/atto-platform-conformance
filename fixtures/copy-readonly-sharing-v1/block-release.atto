define class Scores as
    pub let int n = 20;
end
define class Person as
    pub let mut Scores scores = new Scores();
    pub let int age = 1;
end

pub fnc main(): void {
    let mut Person a = new Person();
    block {
        let mut Person b = copy! a;
        stdio.stdout.write(b.scores.n);
    }
    a.scores.n = 22;
    stdio.stdout.write("|");
    stdio.stdout.write(a.scores.n);
    return;
}
