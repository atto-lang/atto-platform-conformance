define class Person as
    pub let mut Map<string,int> scores = {"old" => 20};
    pub let int age = 1;
end
pub fnc main(): int {
    let mut Person a = new Person();
    let mut Person b = copy! a;
    a.scores["new"] = 99;
    return a.scores.get("old").unwrap() + b.scores.get("old").unwrap() + a.age;
}
