// Expected GPU-G1-SOURCE-002: G1 source subset is kernel-only, no launch.
pub gpu fnc saxpy(f32 scale, GpuArray<f32> x, GpuArray<f32> y,
                  GpuArray<f32> mut out, u64 n) => void {
    const u64 i = gpu.global_id(0);
    if i >= n { return; }
    out[i] = scale * x[i] + y[i];
}
suspends fnc run() => void { launch saxpy() on gpu(device) { over: [n], group: [256] }; }
