pub async fnc main(): int {
  let Future<int> task_handle = task {
    probe_trace("entered");
    await probe_pending();
    probe_trace("post_cancel_forbidden");
    return 1;
  };
  probe_wait_for("entered");
  task_handle.cancel();
  await task_handle.get_done();
  probe_assert_absent("post_cancel_forbidden");
  return 42;
}
