pub suspends fnc main(): int {
  let Task<int> parent = task {
    let Task<int> child = task {
      await probe_pending("descendant_suspended");
      return 1;
    };
    await child;
    return 1;
  };
  let Task<int> sibling = task { return 42; };
  probe_wait_for("descendant_suspended"); // require actual live descendant before cancellation
  parent.cancel();
  await parent.get_done();
  probe_assert_descendants_retired(parent);
  probe_trace("descendants_retired=true");
  let int answer = await sibling;
  probe_assert_sibling_survived();
  probe_trace("sibling_survived=true");
  return answer;
}
