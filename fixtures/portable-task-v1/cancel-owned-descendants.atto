pub async fnc main(): int {
  let Future<int> parent = task {
    let Future<int> child = task { await probe_pending(); return 1; };
    await child;
    return 1;
  };
  let Future<int> sibling = task { return 42; };
  parent.cancel();
  await parent.get_done();
  probe_assert_descendants_retired(parent);
  return await sibling;
}
