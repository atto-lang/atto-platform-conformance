pub suspends fnc main(): int {
  let Task<int> work = task {
    defer { probe_trace("cleanup_once"); }
    await probe_pending();
    return 1;
  };
  probe_wait_for("suspended");
  work.cancel();
  await work.get_done();
  probe_assert_trace_count("cleanup_once", 1);
  probe_trace("physical_done=true");
  return 42;
}
