// Deliberately invalid: reaches a synchronous recursion cycle from a receiver.
// expect-error: E_ACTOR_STACK_RECURSION
// expect-no-artifact: true
fnc bounce(int value): int {
    return bounce(value);
}

define actor A as
    receive(ActorMail<int> mail): void {
        stdio.println(bounce(mail.value));
        return;
    }
end

pub fnc main(): int {
    val a = spawn A();
    a.send(1);
    return 0;
}