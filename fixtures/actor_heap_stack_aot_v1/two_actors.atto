// Canonical first compiled-guest proof: two independent actor instances.
// expect-exit: 0
// expect-stdout: 1
// expect-stdout: 42
// stdout-order: unordered
define actor A as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        return;
    }
end

define actor B as
    receive(ActorMail<int> mail): void {
        stdio.println(mail.value);
        return;
    }
end

pub fnc main(): int {
    val a = spawn A();
    val b = spawn B();
    a.send(1);
    b.send(42);
    return 0;
}