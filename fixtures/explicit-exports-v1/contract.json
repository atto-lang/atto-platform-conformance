{
  "schema": "oreslang.explicit-exports.v1",
  "version": 1,
  "canonical_scopes": [
    "file",
    "pkg",
    "public"
  ],
  "native_exposure": "separate",
  "local_export_resolves_imports": false,
  "export_transparent_to_import_prelude": true,
  "declaration_modifier_orders": [
    "pub define",
    "define pub"
  ],
  "scope_aliases": {
    "pub": "public",
    "export": "public",
    "pub[file]": "file",
    "pub(file)": "file",
    "pub[pkg]": "pkg",
    "pub(pkg)": "pkg",
    "pub[package]": "pkg",
    "pub(package)": "pkg",
    "export[file]": "file",
    "export(file)": "file",
    "export[pkg]": "pkg",
    "export(pkg)": "pkg",
    "export[package]": "pkg",
    "export(package)": "pkg"
  },
  "modifier_cases": [
    {
      "source": "pub define class X",
      "expect": {
        "kind": "class",
        "visibility": "public"
      }
    },
    {
      "source": "define pub class X",
      "expect": {
        "kind": "class",
        "visibility": "public"
      }
    },
    {
      "source": "pub[pkg] define actor X",
      "expect": {
        "kind": "actor",
        "visibility": "pkg"
      }
    },
    {
      "source": "define pub(package) actor X",
      "expect": {
        "kind": "actor",
        "visibility": "pkg"
      }
    },
    {
      "source": "pub define pub class X",
      "error": "DUPLICATE_VISIBILITY"
    }
  ],
  "cases": [
    {
      "name": "forward export before declaration",
      "items": [
        {
          "op": "export",
          "name": "X",
          "kind": "class",
          "scope": "public"
        },
        {
          "op": "decl",
          "name": "X",
          "kind": "class",
          "visibility": "default"
        }
      ],
      "expect": {
        "bindings": [
          {
            "local": "X",
            "external": "X",
            "scope": "public"
          }
        ]
      }
    },
    {
      "name": "export after declaration",
      "items": [
        {
          "op": "decl",
          "name": "X",
          "kind": "class",
          "visibility": "default"
        },
        {
          "op": "export",
          "name": "X",
          "kind": "class",
          "scope": "public"
        }
      ],
      "expect": {
        "bindings": [
          {
            "local": "X",
            "external": "X",
            "scope": "public"
          }
        ]
      }
    },
    {
