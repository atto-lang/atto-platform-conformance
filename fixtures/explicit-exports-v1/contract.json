      "items": [
        {
          "op": "export",
          "name": "X",
          "kind": "class",
          "scope": "public"
        },
        {
          "op": "import",
          "name": "Dep",
          "kind": "class"
        },
        {
          "op": "decl",
          "name": "X",
          "kind": "class",
          "visibility": "default"
