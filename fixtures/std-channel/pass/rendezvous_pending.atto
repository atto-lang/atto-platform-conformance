// target-stdout: 42
// A zero-capacity channel must rendezvous with an actual reader.
import module channel from "std/channel";

pub async routine main(): void {
  val Channel<int> ch = channel.rendezvous<int>();
  val Future<void> writer = channel.send_pending<int>(ch, 42);
  val Future<int> reader = channel.receive_pending<int>(ch);
  stdio.stdout.write(await reader);
  await writer;
  channel.close<int>(ch);
  return;
}
