// target-stdout: 42
// A closed bounded channel must drain previously committed FIFO values.
import module channel from "std/channel";

pub async routine main(): void {
  val Channel<int> ch = channel.bounded<int>(2);
  await channel.send<int>(ch, 20);
  await channel.send<int>(ch, 22);
  channel.close<int>(ch);
  channel.close<int>(ch);
  val int first = await channel.receive<int>(ch);
  val int second = await channel.receive<int>(ch);
  stdio.stdout.write(first + second);
  return;
}
