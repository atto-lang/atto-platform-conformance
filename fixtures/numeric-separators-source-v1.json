{
  "schemaVersion": 1,
  "contract": "oreslang.numeric-separators/source-v1",
  "status": "candidate-unattested",
  "scope": "compiler-source-admission; i64 runtime checks require independent guest execution",
  "targetBackends": [
    "java",
    "llvm",
    "net",
    "wasm-via-llvm"
  ],
  "notes": [
    "These are identical guest source bytes for a candidate cross-backend test, not evidence that any backend ran.",
    "WASM is a pinned LLVM-to-Wasm backend and must not be counted as an independently implemented parser.",
    "No assertion of checked-arithmetic default semantics or actor-feature parity.",
    "Float/exponent/imaginary and actor concurrency separators have Java-only lexer coverage; .NET scalar source subset does not currently support them."
  ],
  "cases": [
