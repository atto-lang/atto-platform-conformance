// expect-error: E_SHARED_MUTATION
// freeze is transitive, not just readonly at the outer edge
define class Leaf as pub let int value = 0; end
define class Root as pub let Leaf child = new Leaf(); end
pub fnc main(): int {
  val root = new Root();
  val frozen = share! root;
  frozen.child.value = 42;
  return 0;
}
