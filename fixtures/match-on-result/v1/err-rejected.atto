// expect-exit: 42
// match-on-result-v1: positive; native Wasm/LLVM guest NOT_EXECUTED
fnc admission(): Result<int,string> { return Err("full"); }
pub fnc main(): int {
  match admission() over
    on Ok(ack) -> { return 0; }
    on Err(err) when err == "full" -> { return 42; }
    on Err(err) -> { return 1; }
  end
}
