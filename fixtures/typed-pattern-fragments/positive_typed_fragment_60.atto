// TARGET ONLY. Requires compiler-backed std.pattern; guest status NOT_EXECUTED.
import module pattern from "std.pattern";

pub fnc main(): int {
  val items: List<int> = List.of(10, 20, 30, 40, 50);
  return match<int> items over
    on List.of(
      pattern.of<int>("..."),
      is int as val a,
      is int as val b,
      is int as val c,
      pattern.of<int>("...")
    ) -> a + b + c,
    on _ -> 0
  end;
}
