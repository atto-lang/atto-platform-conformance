// BCV1-033 pointer pass: target AttoLang semantics, NOT_EXECUTED.
// Expected success and exit value 42.
// TARGET Pointer<T> API; not a portability claim.
pub fnc main(): int {
  let cells: Pointer<int> = Pointer.alloc<int>(1)?;
  cells.write_at(0, 42)?;
  val n: int = cells.read_at(0)?;
  cells.close()?;
  return n;
}
