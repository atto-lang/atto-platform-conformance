// BCV1-025 weak pass: upgrade weak handle while a frozen shared owner is alive.
// expect-exit: 42
// TARGET_ONLY: upgrade's Option<T> and generation-fencing ABI are not ratified.
define class Snapshot as pub let int value = 42; end
pub fnc main(): int {
  val original = new Snapshot();
  val shared = share! original;
  val weak_ref = weak! shared;
  val upgraded = weak_ref.upgrade();
  return upgraded.is_some() ? 42 : 0;
}
