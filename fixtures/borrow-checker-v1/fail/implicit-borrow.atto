// BCV1-004 implicit_borrow fail: target AttoLang semantics, NOT_EXECUTED.
// Expected compiler rejection E_MOVED with NO guest artifact.
define class Meter as pub let int reading = 42; end
fnc inspect(Meter item): int { return item.reading; }
pub fnc main(): int {
  val m = new Meter();
  val other = take! m;
  return inspect(m); // moved owner remains invalid
}
