// expect-error: E_OWNERSHIP
// A partially initialized inline class constructor must not publish self.
define class Counter as
    pub let int value = 0;
    constructor(int initial) {
        publish(self);
        self.value = initial;
    }
end
fnc publish(Counter owner): void {}
pub fnc main(): int {
    val counter = new Counter(42);
    return counter.value;
}
