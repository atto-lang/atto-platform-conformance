// expect-exit: 42
// A completed inline class constructor may be observed through a method.
define class Counter as
    pub let int value = 0;
    constructor(int initial) {
        // self.peek() in a comment is not an executable method call.
        self.value = initial;
    }
    pub peek(): int { return self.value; }
end
pub fnc main(): int {
    val counter = new Counter(42);
    return counter.peek();
}
