// NEGATIVE: immutable val cannot satisfy Interval.cancel(mut self).
// A cancellation mutation must never be accepted through an immutable alias.
import module time from "std/time";
pub routine main(): void {
  val initial = time.instant(7, 0);
  val period = time.nanoseconds(1).expect("period");
  val repeat = time.interval(initial, period);
  repeat.cancel();
  return;
}
