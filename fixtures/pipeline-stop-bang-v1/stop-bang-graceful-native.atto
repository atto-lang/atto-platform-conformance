// Atto native stop! must preserve existing graceful stop lowering and ActorRef ownership.
define actor Worker as {
  const base: int = 40;
  let total: int = 0;
  pub fnc on_message(int n): int { return base + n; }
}
pub fnc main(): int {
  const worker = spawn Worker();
  stop! worker;
  return 43;
}
