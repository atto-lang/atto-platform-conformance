// expect-error: E_MOVED
pub susp fnc main(): int {
  val opened: Result<Channel<int>,IoError> = Channel<int>.bounded(0);
  ^ match opened over
    on Err(error) -> { return -1; }
    on Ok(channel) -> {
      val pending = nb readch channel;
      val first = await pending;
      val second = await pending;
      return 42;
    }
  end
}
