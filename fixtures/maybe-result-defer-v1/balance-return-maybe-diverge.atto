// CANDIDATE SOURCE: nested return is a true function return, not an arm result.
// NOT_EXECUTED on all production compiler backends.
define pub fnc balance(int id) -> Result[float, Error] as
  defer log("balance() completed");

  return maybe
    Ok(user) ?= fetch_user(id);
    Ok(account) ?= fetch_account(user);
    Ok(balance) ?= get_balance(account);
    return Ok(balance)
  else
    Err(reason) -> {
      log_error(reason);
      return Err(reason)
    };
  end;
end
