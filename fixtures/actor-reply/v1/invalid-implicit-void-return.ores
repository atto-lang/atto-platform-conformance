define enum Message as
  Compute Tuple[string, int] 1
  Result Tuple[string, int] 2
end

define actor WorkerActor as
  @Implements
  receive(Message m): void {
    return match m over {
      on Message.Compute as (text, n) {
        return Message.Result(text, n + 1);
      }
      on Message.Result as (text, n) {
        return Message.Result(text, n);
      }
    };
  }
end
