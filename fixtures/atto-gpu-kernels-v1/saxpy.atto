// AttoLang GPU v1 PROPOSED SYNTAX. NOT CURRENTLY PARSEABLE OR EXECUTABLE.
// No device evidence can be inferred from this file.
compute fnc saxpy(x: DeviceRead<f32>, y: DeviceRead<f32>,
                  out: DeviceWrite<f32>, alpha: f32, n: u64) device {
  const i = gpu.global_id.x;
  if i < n {
    out[i] = alpha * x[i] + y[i];
  }
}

const complete = gpu task {
  launch saxpy(x, y, out, alpha, n) with {
    grid: [ceil_div(n, 256), 1, 1],
    block: [256, 1, 1],
    shared_bytes: 0,
    queue: compute_queue
  };
};
await complete;
