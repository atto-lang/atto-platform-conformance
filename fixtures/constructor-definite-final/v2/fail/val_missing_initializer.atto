// expect-error: E_UNSUPPORTED
define class Pair as
    pub final int left; pub final int right; pub val int base;
    constructor(int initial) { self.left = initial; self.right = 0; }
    pub total(): int { return self.left + self.right; }
end
pub fnc main(): int { val p = new Pair(42); return p.total(); }
