// expect-exit: 42
define class Pair as
    pub final int left; pub final int right; pub val int base = 7;
    constructor(int initial) { if initial eq 42 then self.left = initial; self.right = 0; else self.right = initial; self.left = 0; fi }
    pub total(): int { return self.left + self.right; }
end
pub fnc main(): int { val p = new Pair(42); return p.total(); }
