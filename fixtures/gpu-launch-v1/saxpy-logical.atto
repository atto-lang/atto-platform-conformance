// Proposed logical 1D launch. NOT compiler or hardware executed.
pub gpu fnc saxpy(f32 scale, GpuArray<f32> x, GpuArray<f32> y,
                  GpuArray<f32> mut out, u64 n) => void {
    const u64 i = gpu.global_id(0);
    if i >= n { return; }
    out[i] = scale * x[i] + y[i];
}
suspends fnc run(f32 scale, GpuArray<f32> x, GpuArray<f32> y,
                 GpuArray<f32> mut out, u64 n,
                 GpuDevice device, GpuQueue queue) => void {
    const completion = launch saxpy(scale, x, y, out, n) on gpu(device) {
        over: [n], group: [256], queue: queue
    };
    await completion;
}
