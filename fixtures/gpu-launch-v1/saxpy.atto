// Proposed positive AttoLang syntax; NOT YET ACCEPTED/EXECUTED by any pinned backend.
pub gpu fnc saxpy(
    f32 scale,
    GpuArray<f32> x,
    GpuArray<f32> y,
    GpuArray<f32> mut out,
    u64 n
) => void {
    const u64 i = gpu.global_id(0);
    if i >= n { return; }
    out[i] = scale * x[i] + y[i];
    return;
}

suspends fnc run(
    f32 scale, GpuArray<f32> x, GpuArray<f32> y,
    GpuArray<f32> mut out, u64 n,
    GpuDevice device, GpuQueue queue
) => void {
    const completion = launch saxpy(scale, x, y, out, n) on gpu(device) {
        grid: [ceil_div(n, 256), 1, 1],
        block: [256, 1, 1],
        queue: queue,
        shared_bytes: 0
    };
    await completion;
}
