// Expected GPU-LAUNCH-003: zero-sized thread block must fail before enqueue.
pub gpu fnc fill(GpuArray<f32> mut out) => void {
    const u64 i = gpu.global_id(0);
    out[i] = 1.0;
    return;
}
suspends fnc run(GpuArray<f32> mut out, GpuDevice device, GpuQueue queue) => void {
    const done = launch fill(out) on gpu(device) {
        grid: [1, 1, 1], block: [0, 1, 1], queue: queue
    };
    await done;
}
