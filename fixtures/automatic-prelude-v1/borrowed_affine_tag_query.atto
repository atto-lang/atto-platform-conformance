// PRELUDE V1: a read-only borrowed sum query must not consume its owner.
// Not an executed guest or compiler receipt.
// This does not count as executed compiler evidence.
define class Envelope as
  pub val int value = 42;
end
fnc has_value(borrow Option<Envelope> input): bool {
  return input.is_some();
}
pub fnc main(): int {
  val Option<Envelope> owner = Some(new Envelope());
  if has_value(borrow! owner); do
    return owner.unwrap().value;
  fi
  return 0;
}
