// SOURCE-ONLY CONTRACT: routine may not recur indirectly through a fnc.
// expect: REJECT, diagnostic: RECURSIVE_ROUTINE, no output artifact.
routine enter(int remaining): int {
  return hop(remaining);
}
fnc hop(int remaining): int {
  if remaining eq 0 then
    return 42;
  fi
  return enter(remaining - 1);
}
pub fnc main(): int {
  return enter(2);
}
