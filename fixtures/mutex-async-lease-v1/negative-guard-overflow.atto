// COMPILE-NEGATIVE: E_OVERFLOW. Constant update would trap under a live guard.
susp fnc increment(Mutex<int> counter): int {
  using await counter.lock_async() as lease {
    lease.value += 1;
    return lease.value;
  }
}
pub susp fnc main(): int {
  val counter = Mutex<int>(9223372036854775807);
  return await increment(counter);
}
