// Source-only GPU proposal; no compiler-backed or physical GPU evidence.
pub gpu fnc saxpy(
    f32 alpha,
    GpuArray<f32> x,
    GpuArray<f32> y,
    GpuArray<f32> mut out,
    u64 n,
    u64 n
) -> void {
    const u64 i = gpu.global_id(0);
    if i >= n { return; }
    out[i] = alpha * x[i] + y[i];
}
