pub fnc main(): void {
  val Channel<int> left = Channel.new<int>(2);
  val Channel<int> right = Channel.new<int>(2);
  writech left, 10;
  writech left, 11;
  writech right, 20;
  writech right, 21;
  val SelectPlan plan = SelectPlan.from_list([
    SelectCase.read(left), SelectCase.read(right)
  ]);
  val Option<SelectResult> first = try select fair from plan;
  val Option<SelectResult> second = try select fair from plan;
  stdio.stdout.write(first.unwrap().index);
  stdio.stdout.write(":");
  stdio.stdout.write(first.unwrap().value);
  stdio.stdout.write(":");
  stdio.stdout.write(second.unwrap().index);
  stdio.stdout.write(":");
  stdio.stdout.write(second.unwrap().value);
  return;
}
