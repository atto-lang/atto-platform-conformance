// TARGET ONLY: scheduler trace MUST show grant -> active -> release -> child physical retirement.
pub susp fnc main(): int {
  val counter = Mutex<int>(0);
  val Future<void> worker = task<void> {
    using await counter.lock_async() as lease {
      lease.value += 1;
    }
    return;
  };
  worker.cancel();
  return 42;
}
