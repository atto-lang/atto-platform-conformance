    "runnerAdmission": "steps=[] or null, or runnerId=0: UNVERIFIED_RUNNER_ADMISSION",
    "requiredForIndependentPromotion": [
      "exact PR head SHA and Git tree",
      "canonical .atto fixture SHA-256",
      "nonzero steps on that head",
      "actual compiler plus native/managed guest execution",
      "complete job/run URLs and raw output digest",
      "negative mutation execution receipts",
      "independent reviewer"
    ],
