{
  "contract": "oreslang.media-replay.vectors/1",
  "description": "Pure state-machine operation vectors. They are not guest execution receipts.",
  "cases": [
    {
      "name": "ack_then_replay",
      "capacityBytes": 8,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1
          ],
          "randomAccess": true,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 1,
          "bytes": [
            2
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 2,
          "offset": 2,
          "bytes": [
            3
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "ack",
          "sequence": 0,
          "endOffset": 1,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "resume",
          "lastAppliedSequence": 0,
          "lastAppliedEndOffset": 1,
          "expect": {
            "ok": true,
            "mode": "replay",
            "sequences": [
              1,
              2
            ]
          }
        }
      ]
    },
    {
      "name": "eviction_requires_keyframe_reset",
      "capacityBytes": 8,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 1,
          "bytes": [
            2
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 2,
          "offset": 2,
          "bytes": [
            3
          ],
          "randomAccess": true,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "ack",
          "sequence": 1,
          "endOffset": 2,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "resume",
          "lastAppliedSequence": -1,
          "lastAppliedEndOffset": 0,
          "expect": {
            "ok": true,
            "mode": "reset",
            "sequences": [
              2
            ]
          }
        }
      ]
    },
    {
      "name": "incarnation_fencing",
      "capacityBytes": 8,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "fence",
          "newGeneration": 2,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "ack",
          "generation": 1,
          "sequence": 0,
          "endOffset": 1,
          "expect": {
            "code": "STALE_STREAM_GENERATION"
          }
        },
        {
          "op": "resume",
          "generation": 1,
          "lastAppliedSequence": -1,
          "lastAppliedEndOffset": 0,
          "expect": {
            "code": "STALE_STREAM_GENERATION"
          }
        },
        {
          "op": "resume",
          "generation": 2,
          "lastAppliedSequence": -1,
          "lastAppliedEndOffset": 0,
          "expect": {
            "ok": true,
            "mode": "continue",
            "sequences": []
          }
        }
      ]
    },
    {
      "name": "full_window_never_drops_unacked",
      "capacityBytes": 2,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1,
            2
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 2,
          "bytes": [
            3
          ],
          "expect": {
            "code": "BACKPRESSURE"
          }
        },
        {
          "op": "ack",
          "sequence": 0,
          "endOffset": 2,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 2,
          "bytes": [
            3
          ],
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "codec_mismatch_requires_decoder_reset",
      "capacityBytes": 8,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1
          ],
          "randomAccess": true,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 1,
          "bytes": [
            2
          ],
          "expect": {
            "ok": true
          }
        },
        {
          "op": "resume",
          "lastAppliedSequence": -1,
          "lastAppliedEndOffset": 0,
          "codecConfigId": "other-config",
          "expect": {
            "ok": true,
            "mode": "reset",
            "sequences": [
              0,
              1
            ]
          }
        }
      ]
    },
    {
      "name": "misreported_checkpoint_rejected",
      "capacityBytes": 8,
      "operations": [
        {
          "op": "append",
          "sequence": 0,
          "offset": 0,
          "bytes": [
            1
          ],
          "randomAccess": true,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "append",
          "sequence": 1,
          "offset": 1,
          "bytes": [
            2
          ],
          "randomAccess": true,
          "expect": {
            "ok": true
          }
        },
        {
          "op": "resume",
          "lastAppliedSequence": 0,
          "lastAppliedEndOffset": 0,
          "expect": {
            "code": "CHECKPOINT_OFFSET_MISMATCH"
          }
        }
      ]
    }
  ]
}
