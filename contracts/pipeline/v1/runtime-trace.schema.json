{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oreslang:pipeline:runtime-trace:v1",
  "title": "Bounded compiled actor pipeline transition trace (proof-interface, not provenance)",
  "description": "Only the five-hop single-flow three-stage slice; a valid transcript is not evidence that a real runtime produced it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "backend",
    "sourceGitBlobSha1",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "compiled-actor-pipeline-trace-v1"
    },
    "backend": {
      "enum": [
        "llvm-native",
        "java-graalvm"
      ]
    },
    "sourceGitBlobSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "op",
        "epoch",
        "request",
        "hop",
        "ticket",
        "stage",
        "variant",
        "value"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "op": {
          "enum": [
            "reserve",
            "publish",
            "deliver",
            "finalize",
            "complete",
            "stop",
            "restart",
            "drop-stale"
          ]
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "request": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hop": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "ticket": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "source",
            "transform",
            "sink",
            null
          ]
        },
        "variant": {
          "enum": [
            "Signal.Data",
            "Signal.Result",
            null
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
