      "expected": {
        "guest_exit": 42,
        "runtime_witnesses": [
          "if_granted: lease_released_exactly_once_before_child_retired",
          "cancel_requested_not_equivalent_to_retired",
          "no_handoff_while_active_lease",
          "parent_capture_storage_reclaimed_after_child_physically_retired"
        ]
      }
    },
