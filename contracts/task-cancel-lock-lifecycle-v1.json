  "causal_requirements": [
    "Cancellation request must not force unlock active lease",
    "Cancelled queued waiter and unclaimed grant may be revoked atomically",
    "Child cleanup releases all acquired guards exactly once and in reverse order before terminal publication",
    "Tenant/actor ownership and generation-fenced wakeups are mandatory",
    "Cancellation request, terminal outcome and physical retirement are distinct",
    "No scheduler-carrier parking or suspension under a synchronous guard",
    "No cross-tenant access or unverified scoped borrowed capture"
  ],
  "cases": [
    {
      "id": "cancel_active_lock_scope",
