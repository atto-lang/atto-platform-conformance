    "nominal_identity_free",
    "deep_immutable",
    "once_initialized",
    "type_safe_equality",
    "no_identity_operations",
    "copy_without_fresh_identity",
    "sendable_is_not_serializable",
    "full_aot_no_jit",
    "no_silent_heap_class_equivalence"
  ],
