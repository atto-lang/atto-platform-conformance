  "evidence_rule": "No row is passed without exact-source-sha compiler AND executable guest evidence (negative cases require compiler diagnostic and no artifact); host-only/parse-only checks cannot prove semantics. Mark all backends NOT_EXECUTED until verified.",
  "operator_contract": {
    "value_equality": "eq",
    "value_inequality": "neq",
    "reference_identity": "== and != are E_VALUE_IDENTITY for nominal value classes",
    "linked_proposal": "atto-lang/atto-spec#62",
    "notes": "Do not lower identity syntax to field equality, and never claim identity for a nominal value class."
  }
