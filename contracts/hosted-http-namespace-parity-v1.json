{
  "schema": "atto.namespace_http.import_parity.v1",
  "status": "ALL_NOT_EXECUTED",
  "authority": "atto-lang/atto-spec/language/unified-static-imports-v1.md",
  "source_policy": "COMPILER_OWNED_BACKEND_LOCAL_NATIVE_ATTO",
  "canonical_import": "import * as http from \"std.http\";",
  "selective_import": "import module http3 from \"./library_public.atto\";",
  "public_module_declaration": "define pub module http3 as",
  "default_module_visibility": "PRIVATE",
  "import_contract": {
    "builtin": "std.http",
    "symbol": "status_valid",
    "symbol_return": "bool",
    "argument": "int",
    "example_true": 200,
    "example_false": 99,
    "builtin_must_be_registered": true,
    "ambient_file_or_package_fallback": false,
    "module_export_visibility": "PUBLIC_ONLY",
    "module_namespace_and_selective_module_differ": true,
    "capability_granted_by_import": false
  },
  "fixtures": {
