{
  "schemaVersion": 1,
  "contract": "attolang.aot-reflection/1",
  "status": "candidate-unattested",
  "originalDesign": "https://chatgpt.com/share/6ae8ab63-a31c-83e9-a8ac-7bb1f158d410",
  "backends": {
    "java": "GraalVM Native Image",
    "llvm": "LLVM native object and executable",
    "wasm": "Wasm AOT or precompiled module in isolated runtime",
    "forge": "independent Cranelift/Forge AOT",
    "net": ".NET NativeAOT publish"
  },
  "api": {
    "type_of": "type_of<T>()",
    "fields_of": "fields_of<T>() or type_descriptor.fields()",
    "methods_of": "methods_of<T>() or type_descriptor.methods()",
    "implements": "implements<T,I>()",
    "status": "proposed semantic names; syntax and parser acceptance not established"
  },
  "descriptor": {
    "encoding": "canonical versioned immutable table",
    "identity": [
      "verified-package-identity",
      "fully-resolved-type-symbol",
      "closed-generic-arguments",
      "schema-abi-version"
    ],
    "layout": "target-specific ABI section separated from portable metadata",
    "handles": "opaque read-only bounded indices; never guest raw pointers",
    "visibility": "public metadata by default; private and live state gated separately by runtime-issued authority",
    "retention": "opt-in per reachable type and capability; unused tables subject to verified linker dead-code elimination",
    "hotLoad": "precompiled signed or hash-pinned modules; ABI version and generation fences"
  },
  "nonGoals": [
    "runtime Reflection.Emit",
    "runtime bytecode generation",
    "JIT-required semantics",
    "runtime source evaluation",
    "unguarded dynamic invocation",
    "unbounded classpath scanning",
    "descriptor access that bypasses borrow rules"
  ],
  "evidenceRequired": [
    "exact-source-commit-and-tree-sha",
    "compiler-binary-sha256-and-build-provenance",
    "fixture-sha256",
    "nonzero-executed-job-steps",
    "actual-guest-compiler-invocation",
    "compiled-native-or-aot-artifact-sha256",
    "native-or-wasm-aot-guest-execution",
    "asserted-reflection-output-and-denials",
    "linker-retention-inspection",
    "independent-review"
  ],
  "cases": [
