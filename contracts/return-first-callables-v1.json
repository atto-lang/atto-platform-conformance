  "semantics": {
    "left_arrow": "Contiguous <- in declaration headers; not assignment or expression operator",
    "return_first": [
      "fnc T <- name(params)",
      "T <- name(params)"
    ],
    "return_types": [
      "int",
      "void",
      "infer"
    ],
    "bodies": [
      "{ statement... }",
      "statement; ... end",
      "begin statement; ... end"
    ],
    "name_first_colon_arrow": "fnc name(params): T -> { ... }",
    "signature_equivalence": "All syntaxes lower to same nominal signature; duplicates rejected by owner/name/arity",
    "inference": "Explicit infer only; no omitted annotation",
    "empty_void": "Allowed with braces, bare end, or begin/end; nonvoid must return",
    "legacy_erlang": "Comma/end tail-expression semantics retained independently"
  },
