{
  "schema": "oreslang.actor-dispatch-ticket-generation.v1",
  "version": 1,
  "status": "PROPOSED_NOT_EXECUTED",
  "relation": {
    "actorFinalizationScenario": "AF08",
    "javaReferenceDraft": "https://github.com/ores-truffle-oreslang/oreslang-source.java/pull/3127"
  },
  "scope": "bounded per-actor scheduling and physical turn lease authority; this is not a guest language ABI",
  "ticketIdentity": [
    "actor_id",
    "actor_incarnation",
    "slot",
    "generation"
  ],
  "rules": [
    "A completion, cancel or wake may mutate scheduling authority only if all four ticket identity fields match the current lease.",
    "A stale or duplicated completion must be a no-op, including when a newer generation reuses the exact numeric slot.",
    "An active physical worker must retain the exact ticket it entered until legitimate completion or explicitly authorized cancellation.",
    "STOP fences issuance of new turns while allowing an already admitted physical turn to drain or safely retire.",
    "A generation counter must never silently wrap to a still-replayable identity; on exhaustion the issuer must reject or use a provably noncolliding epoch.",
    "Supervisor CONTROL and DATA delivery rules remain separate; rejecting a stale ticket must not consume or forge CONTROL authority."
  ],
  "fixtureNotation": {
    "identity": "a tuple [actor_id, actor_incarnation, slot, generation]",
    "active": "the exact live worker-held lease before the attempted action, or null",
    "action": "an abstract scheduling event; not a claim that any backend exposes this as a guest API",
    "outcome": "the required externally observable authority transition"
  },
