  "semantics": {
    "scope": "ordinary type-first class fields only; no change to type-first locals, module define const, structs/records or sealed actor state",
    "default": "T field = e is exactly let T field = e, regardless of T (including generic instantiations)",
    "binding": {
      "let": "reassignable",
      "val": "not reassignable",
      "final": "single definite assignment only",
      "const": "non-reassignable with constexpr initializer"
    },
    "referent": {
      "mut": "separate requested writable-referent permission; no ownership bypass",
      "omitted": "no writable referent permission from declaration alone"
    },
    "local_shorthand": "type-first local T x = e remains const T x = e",
    "const_scope": "class const is constexpr; file/module direct os.read_env runtime-once special case does not apply",
    "actor": "sealed actor state remains access-controlled; no bypass via class default"
  },
