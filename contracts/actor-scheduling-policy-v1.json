    "fixed_cap_min": 1,
    "pool_size": "DYNAMIC_ELIGIBLE_HEALTHY_POOL_CARRIERS",
    "pool_size_evaluated_at": "EACH_ADMISSION_AND_POOL_CHANGE",
    "effective_cap": "MIN_REQUEST_HEALTHY_ACTOR_TENANT_GLOBAL",
    "zero_healthy": "NO_WORKER_RESERVED",
