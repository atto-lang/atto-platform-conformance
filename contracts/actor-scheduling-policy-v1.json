      "none",
      "sticky",
      "pinned",
      "dedicated"
    ],
    "default_serial_affinity": "sticky",
    "pinned_single_carrier": true,
    "pinned_worker_death": "FENCED_REPIN",
    "dedicated_single_carrier": true,
    "dedicated_quota": "REQUIRE_EXPLICIT_RESERVATION_OR_DENY",
    "pool_domains": [
      "shared",
      "isolated",
      "untrusted"
    ],
    "cross_domain_fallback": "FORBIDDEN",
    "spawn_override": "NARROW_ONLY",
    "shrink": "NO_NEW_ADMISSIONS_ABOVE_REDUCED_CAP_DRAIN_INFLIGHT",
    "stop": "SEAL_NEW_GUEST_ADMISSIONS_PRESERVE_BOUNDED_CLEANUP",
    "security": "AUTHENTICATED_HOST_POOL_ID_NOT_GUEST_MUTABLE",
    "guest_proof_required": true
  },
