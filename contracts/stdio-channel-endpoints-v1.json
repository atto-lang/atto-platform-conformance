  "dynamic_gates": [
    "stdin alias identity",
    "no blocking carrier",
    "bounded output queue/backpressure",
    "read cancellation before/after commit",
    "exactly one resumed read",
    "injected browser/Wasm stdin admission",
    "tenant generation revocation",
    "same-process no cross-tenant descriptors",
    "malformed UTF-8 checked error",
    "max-item-size checked error",
    "SIGPIPE converted to checked error",
    "teardown drain cannot park carrier"
