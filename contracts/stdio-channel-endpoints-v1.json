{
  "schema": "atto.stdio.channel.endpoints.v1",
  "version": 1,
  "status": "TARGET_NOT_EXECUTED",
  "normative_reference": {
    "repo": "atto-lang/atto-spec",
    "pr": 32,
    "path": "language/stdio-channel-endpoints-v1.md",
    "adt_pattern_path": "language/adt-is-variant-patterns-v1.md"
  },
  "data_contract": {
    "process_aliases": {
      "stdio.in": "process.stdin",
      "stdio.out": "process.stdout",
      "stdio.err": "process.stderr"
    },
    "text_encoding": "utf-8",
    "input_framing": "LF-delimited records, CR before LF stripped, nonempty final line once",
    "stdin_outcome": "Result<Option<string>,IoError>",
    "output_outcome": "Result<void,IoError>",
    "carrier_threads_may_park": false,
    "active_stdin_consumers": 1,
    "tenant_stdio_ambient": false,
    "checked_read_spellings": [
      "readch input",
      "<< input"
    ],
    "checked_success_discard": [
      "on Ok",
      "on Ok(_)"
    ],
    "is_adt_pattern_equivalences": {
      "on is Ok<_>": "on Ok(_)",
      "on is Ok<line>": "on Ok(line)",
      "on is Some<item>": "on Some(item)",
      "on is Err<error>": "on Err(error)",
      "on is None": "on None"
    },
    "is_angle_pattern_binding": "static nominal ADT payload binding, never generic type assertion or user-defined extractor",
    "is_nested_result_rule": "Ok(line) binds Option<string>, not string; Some(item) binds string; EOF is None"
  },
  "required_cases": [
    {
      "id": "checked_echo",
      "kind": "guest-pass",
      "path": "fixtures/stdio-channel/pass/echo_checked.atto",
      "runs": [
        {
          "id": "one_line",
          "stdin": "hello\n",
          "stdout": "Echo the next input item:hello",
          "stderr": "echo complete",
          "exit": 0
        },
        {
          "id": "empty_line",
          "stdin": "\n",
          "stdout": "Echo the next input item:",
          "stderr": "echo complete",
          "exit": 0
        },
        {
          "id": "eof",
          "stdin": "",
          "stdout": "Echo the next input item:",
          "stderr": "",
          "exit": 11
        },
        {
          "id": "unterminated",
          "stdin": "last",
          "stdout": "Echo the next input item:last",
          "stderr": "echo complete",
          "exit": 0
        },
        {
          "id": "crlf",
          "stdin": "hello\r\n",
          "stdout": "Echo the next input item:hello",
          "stderr": "echo complete",
          "exit": 0
        },
        {
          "id": "unicode",
          "stdin": "é💡\n",
          "stdout": "Echo the next input item:é💡",
          "stderr": "echo complete",
          "exit": 0
        },
        {
          "id": "nul",
          "stdin": "a\u0000b\n",
