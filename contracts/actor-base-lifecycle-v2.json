{
  "schema": "atto.actor.base-lifecycle/2",
  "status": "PROPOSED_SOURCE_FREE_NOT_GUEST_VERIFIED",
  "stacks_on": "atto.actor.external-entrypoints/1",
  "authority": "COMPILER_RUNTIME_OWNED",
  "base": {
    "nominal_type": "Actor",
    "cannot_be_user_defined": true,
    "final_operations": [
      "spawn",
      "send",
      "send_async",
      "get_ready",
      "get_done",
      "stop",
      "graceful_stop",
      "cancel",
      "is_alive",
      "actor_identity",
      "supervisor_notice"
    ],
    "cannot_override_lifecycle_state_machine": true,
    "actor_ref_not_serializable": true
  },
  "roles": {
    "init": {
      "entry": "external",
      "requirement": "optional",
      "max_invocations_per_incarnation": 1,
      "default": "no_op",
      "effect": "actor_owned_pre_ready",
      "return": "void",
      "direct_guest_call": false
    },
    "receive": {
      "entry": "external",
      "requirement": "required_for_mailbox_actor",
      "default": "none",
      "param": "ActorMail<T>",
      "effect": "serialized_actor_mailbox_turn",
      "direct_guest_call": false
    },
    "tear_down": {
      "entry": "runtime_only",
      "requirement": "optional",
      "max_invocations_per_incarnation": 1,
      "default": "no_op",
      "effect": "bounded_cooperative_graceful_cleanup",
      "direct_guest_call": false,
      "may_suspend": false,
      "invoked_on": [
        "GRACEFUL_STOP"
      ],
      "not_invoked_on": [
        "PANIC",
        "FORCE_KILL",
        "INIT_FAILURE"
      ]
    },
    "on_throw": {
      "entry": "runtime_only",
      "requirement": "optional",
      "max_invocations_per_failure": 1,
      "default": "no_op",
      "effect": "diagnostic_observer_only",
      "cannot_swallow": true,
      "not_guest_callable": true
    },
    "on_raise": {
      "entry": "runtime_only",
      "requirement": "optional",
      "max_invocations_per_failure": 1,
      "default": "no_op",
      "effect": "diagnostic_observer_only",
      "cannot_swallow": true,
      "not_guest_callable": true
    },
    "on_panic": {
      "entry": "supervisor_only",
      "requirement": "not_actor_hook",
      "guest_implementable": false
    }
  },
  "role_compatibility": {
    "legacy_on_start": "versioned_adapter_only_never_together_with_init",
    "legacy_on_message": "versioned_adapter_only_never_together_with_receive",
    "reject_duplicate_slots_across_files": true,
    "reject_public_external_hooks": true,
    "reject_unmarked_runtime_entrypoint": true,
    "external_is_not_public_rpc": true
  },
  "state_contract": {
    "state_storage": "actor_owned_sealed",
    "schema_enforcement": "compiler_owned_nominal_state_witness",
    "actor_trait_behavioral_only": true,
    "trait_can_require_methods_and_output_types": true,
    "trait_must_not_grant_state_critical_or_supervisor_authority": true,
    "required_state_fields_must_be_verified_against_attached_state_schema": true,
    "uninitialized_required_fields": "compile_error",
    "mutable_state_access": "checked_critical_read_or_critical_write_loan_only",
    "direct_field_access": "compile_error",
    "state_alias_crossing_turn_or_await": "compile_error",
    "initializer_before_ready": "REQUIRED"
  },
  "lifecycle": {
    "phases": [
      "ALLOCATED",
      "INITIALIZING",
      "READY",
      "TURN_RUNNING",
      "STOPPING",
      "DRAINING",
      "TEARDOWN",
      "TERMINATED"
    ],
    "terminal_outcomes": [
      "COMPLETED",
      "FAILED",
      "CANCELLED",
      "PANICKED",
      "QUARANTINED"
    ],
    "allowed_transitions": {
      "ALLOCATED": [
        "INITIALIZING",
        "STOPPING"
      ],
      "INITIALIZING": [
        "READY",
        "STOPPING"
      ],
      "READY": [
        "TURN_RUNNING",
        "STOPPING"
      ],
      "TURN_RUNNING": [
        "READY",
        "STOPPING"
      ],
      "STOPPING": [
        "DRAINING"
      ],
      "DRAINING": [
        "TEARDOWN",
        "TERMINATED"
      ],
      "TEARDOWN": [
        "TERMINATED"
      ],
      "TERMINATED": []
    },
    "ready": "success_only_after_complete_state_init; failure_on_stop_before_ready",
    "done": "settles_only_after_physical_retirement_including_tasks_resource_loans_and_callbacks",
    "restart": "new_incarnation_strictly_increasing_generation_after_prior_physical_retirement",
    "non_reentrancy": "one_physical_guest_turn_per_incarnation; runtime may enqueue bounded pending mail before READY",
    "control_lane": "supervisor_failure_and_panic_not_guest_data"
  },
  "events": [
    {
      "name": "SPAWN_ACCEPTED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "INIT_STARTED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "READY_PUBLISHED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "MAIL_ACCEPTED",
      "origin": "mailbox",
      "authority": "DATA",
      "phase_gate": "BOUNDED_PRE_READY_QUEUE_PERMITTED; NEVER_DELIVER_BEFORE_READY"
    },
    {
      "name": "TURN_STARTED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "TURN_SETTLED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "STOP_REQUESTED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "MAILBOX_SEALED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "DRAIN_COMPLETED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "TEARDOWN_STARTED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "TEARDOWN_COMPLETED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "PHYSICALLY_RETIRED",
      "origin": "runtime",
      "authority": "CONTROL"
    },
    {
      "name": "FAILURE_REPORTED",
      "origin": "supervisor",
      "authority": "CONTROL"
    },
    {
      "name": "RESTART_ADMITTED",
      "origin": "supervisor",
      "authority": "CONTROL"
    }
  ],
  "evidence_policy": {
    "status_precedence": [
      "SOURCE_FREE_MODEL",
      "PARSED",
      "TYPED",
      "COMPILED",
      "GUEST_EXECUTED",
      "NATIVE_AOT_EXECUTED"
    ],
    "no_synthetic_promotion": true,
    "expected_targets": [
      "java",
      "llvm",
      "net",
      "wasm",
      "forge"
    ],
    "required": [
      "exact_commit_and_tree_sha",
      "verified_fixture_blob_sha",
      "actual_compiler_diagnostics",
      "stepful_runner_receipts",
      "real_guest_init_receive_stop",
      "supervisor_failure_notice",
      "physical_retirement",
      "restart_generation_fence",
      "aot_when_supported"
    ]
  },
