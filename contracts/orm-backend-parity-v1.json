    {
      "id": "catalog_rename_preserves_stable_id",
      "category": "snapshot",
      "expect": "accept"
    },
    {
      "id": "catalog_reordered_snapshot_no_phantom_drift",
      "category": "snapshot",
      "expect": "accept"
