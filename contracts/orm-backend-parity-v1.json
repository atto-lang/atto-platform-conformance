{
  "contract": "oreslang.orm-backend-parity/1",
  "description": "Source-level target inventory and conceptual ORM catalog review oracles; these are NOT executable Oreslang guest fixtures or observed parity results.",
  "backends": {
    "java": {
      "repository": "ores-truffle-oreslang/oreslang-source.java",
      "modes": [
        "jit",
        "native-aot"
      ]
    },
    "llvm": {
      "repository": "ores-truffle-oreslang/oreslang-source.llvm",
      "modes": [
        "native-aot"
      ]
    },
    "wasm": {
      "repository": "ores-truffle-oreslang/oreslang-source.wasm",
      "modes": [
        "wasm"
      ]
    },
    "cranelift": {
      "repository": "ores-truffle-oreslang/oreslang-source.cranelift",
      "modes": [
        "cranelift-jit",
        "cranelift-aot"
      ]
    },
    "forge": {
      "repository": "ores-truffle-oreslang/oreslang-source.forge",
      "modes": [
        "forge-jit",
        "forge-aot"
      ]
    },
    "net": {
      "repository": "ores-truffle-oreslang/oreslang-source.net",
      "modes": [
        "native-aot"
      ]
    }
  },
