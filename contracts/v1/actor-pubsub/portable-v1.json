{
  "schema": "oreslang.actor_pubsub.portable.v1",
  "status": "PROPOSED_NOT_EXECUTED",
  "backends": [
    "java",
    "llvm",
    "wasm",
    "cranelift",
    "net"
  ],
  "protocol": "deterministic action vectors; oracle tests do not establish compiler execution",
  "scope": "runtime-local, typed, non-durable",
  "semantics": {
    "topic_identity": "broker-instance + exact ASCII name + payload type",
    "join": "idempotent admission, with no second affine membership grant",
    "subscribe": "at most one live registration per topic/target edge; duplicate subscribe returns that registration without new quota; mismatched capacity is SubscriptionConflict",
    "payload": "transitively immutable shared, Sendable type",
    "fanout": "once per distinct subscription and eligible actor; overlap not deduplicated",
    "linearization": "atomic all-or-nothing fanout at topic admission; one monotonic u64 sequence per topic",
    "capacity": "per subscription-recipient outstanding = queued + in-flight",
    "failure": "Full, Closed, Busy, ResourceExhausted, SequenceExhausted, NotShared, StaleTarget, SubscriptionConflict",
    "unsubscribe": "idempotent admission-and-start fence, cancel queued, finish in-flight before done",
    "actor_termination": "revoke memberships, close direct subscriptions, remove pending group deliveries",
    "shutdown": "cancel queued, finish in-flight, then quiescent; no persistence/replay",
    "transport": "redis and network only via adapter; not core guest language",
    "receipt": "admission only, never consumer ack"
  },
  "action_format": "array whose first element is operation; expected observes errors and delivery envelopes",
