    {
      "id": "actor-scoped-critical-write",
      "concern": "actors",
      "expect": "accept",
      "source": "define actor Counter as\n  state { value: int = 0; }\n  receive(ActorMail<int> m): void with state.write {\n    using state.write(critical |s| -> {\n      s.value = s.value + m.value;\n    });\n    return;\n  }\nend\npub fnc main(): int { return 42; }\n",
      "rationale": "Sealed lexical state access requires a verified write effect and critical state loan.",
      "authority": "https://github.com/ores-truffle-oreslang/oreslang-source.java/blob/main/docs/ACTOR_FAMILIES_SEALED_STATE_V1.md",
      "backends": {
        "java": "PENDING_GUEST_PROOF",
        "llvm": "PENDING_GUEST_PROOF",
        "net": "PENDING_GUEST_PROOF",
        "wasm": "PENDING_GUEST_PROOF"
      }
    },
    {
      "id": "actor-state-loan-escape",
      "concern": "actors",
      "expect": "reject",
      "diagnosticCode": "E_BORROW_ESCAPE",
      "source": "define actor Counter as\n  state { value: int = 0; }\n  receive(ActorMail<int> m): void with state.read {\n    val any escaped = self.handle_state(|s| -> { return s; });\n    return;\n  }\nend\npub fnc main(): int { return 42; }\n",
      "rationale": "Actor state reference must not escape handle_state or its lexical scope.",
      "authority": "https://github.com/ores-truffle-oreslang/oreslang-source.java/blob/main/docs/ACTOR_FAMILIES_SEALED_STATE_V1.md",
      "backends": {
        "java": "PENDING_GUEST_PROOF",
        "llvm": "PENDING_GUEST_PROOF",
        "net": "PENDING_GUEST_PROOF",
        "wasm": "PENDING_GUEST_PROOF"
      }
    },
