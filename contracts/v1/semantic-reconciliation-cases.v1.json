      "concern": "futures",
      "expect": "accept",
      "source": "pub fnc nested(): Future<Future<int>> {\n  return Future.resolved(Future.resolved(42));\n}\npub suspends fnc use(): int {\n  val Future<int> inner = await nested();\n  return await inner;\n}\npub fnc main(): int { return 42; }\n",
      "rationale": "One await returns Future<int>, not int.",
      "authority": "https://github.com/ores-truffle-oreslang/oreslang-source.java/blob/main/docs/NESTED_OPTION_FUTURE_EXTRACTION.md",
      "backends": {
