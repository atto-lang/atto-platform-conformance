      "id": "nested-option-one-layer",
      "concern": "wrappers",
      "expect": "accept",
      "source": "pub fnc main(): int {\n  val Option<Option<int>> nested = Some(Some(42));\n  val Option<int> inner = nested.unwrap();\n  return inner.unwrap();\n}\n",
      "rationale": "Explicit two one-layer unwraps preserve generic layers.",
      "authority": "https://github.com/ores-truffle-oreslang/oreslang-source.java/blob/main/docs/NESTED_OPTION_FUTURE_EXTRACTION.md",
