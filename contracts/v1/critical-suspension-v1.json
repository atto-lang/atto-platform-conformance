{
  "schema": "oreslang.critical-suspension.contract/1",
  "status": "proposed-unimplemented",
  "target_backends": [
    "java-graal",
    "llvm",
    "cranelift",
    "dotnet-nativeaot",
    "wasm"
  ],
  "required_semantics": {
    "critical_acquire_may_suspend": true,
    "critical_body_must_not_suspend": true,
    "critical_uncontended_no_forced_yield": true,
    "try_critical_never_waits": true,
    "serial_actor_turn_distinct_from_mutex": true,
    "async_modifier_only_for_generators": true,
    "positive_guest_evidence_required": true
  },
  "cases": [
    {
      "id": "sync-fnc",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "fnc plain(): int { return 7; }"
    },
    {
      "id": "suspends-fnc",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "suspends fnc plain(): int { return 7; }"
    },
    {
      "id": "critical-fnc-sync",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "critical fnc increment(): void { do_increment(); }"
    },
    {
      "id": "critical-block-in-suspends",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "suspends fnc update(): void { critical gate { do_increment(); } }"
    },
    {
      "id": "try-critical-in-sync",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "fnc attempt(): bool { try critical gate { return true; } else { return false; } }"
    },
    {
      "id": "async-generator-lazy",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "async gen* values(): AsyncIterator<int> { yield 7; return; }"
    },
    {
      "id": "sync-generator",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "gen* values(): Iterator<int> { yield 7; return; }"
    },
    {
      "id": "suspend-generator-compat",
      "phase": "compile-pass",
      "evidence_required": "compiler-invocation",
      "proposed_source": "suspend gen* values(): AsyncIterator<int> { yield 7; return; }"
    },
    {
