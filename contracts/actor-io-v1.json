  "vectors": [
    {
      "id": "io_out_actor",
      "expected": "accept_and_execute_when_supported",
      "source": "pub suspends actor fnc worker(String value) -> void { await io.out.write(value); return; }"
    },
    {
      "id": "stdio_actor",
      "expected": "reject",
      "diagnostic": "process-level I/O",
      "source": "pub actor fnc worker(String value) -> void { stdio.println(value); return; }"
    },
    {
      "id": "print_actor",
      "expected": "reject",
      "diagnostic": "process-level I/O",
      "source": "pub actor fnc worker(String value) -> void { print(value); return; }"
    },
    {
      "id": "root_io",
      "expected": "reject",
      "diagnostic": "unknown name",
      "source": "pub routine main(): void { io.out.write(\"x\"); return; }"
    },
    {
      "id": "io_capture",
      "expected": "reject",
      "diagnostic": "invoke it directly",
      "source": "pub actor fnc worker(String value) -> void { val writer = io.out.write; return; }"
    },
    {
      "id": "io_discard",
      "expected": "reject",
      "diagnostic": "await it",
      "source": "pub suspends actor fnc worker(String value) -> void { io.out.write(value); return; }"
    },
    {
      "id": "io_actorref_output",
      "expected": "reject",
      "diagnostic": "data-only",
      "source": "define actor Child as receive(ActorMail<String> mail): void { self.end(); return; } end pub suspends actor fnc worker(String value) -> void { await io.out.write(spawn Child()); return; }"
    },
    {
      "id": "mailbox_actorref",
      "expected": "accept_when_actor_source_supported",
      "source": "define actor Registry as receive(ActorMail<ActorRef<Registry>> mail): void { return; } end pub routine main(): void { val registry = spawn Registry(); registry.send(registry); return; }"
    }
  ],
