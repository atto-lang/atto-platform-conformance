  "languageRules": {
    "actorSyntax": "define isolated actor Name as ... end",
    "actorState": "actor-owned sealed state, critical handle_state, non-reentrant",
    "virtualActors": "opt-in, existing spawn lifecycle preserved",
    "effectMethod": "suspends fnc; critical bodies never suspend",
    "snapshots": "owned encoded immutable bytes; no guest/native pointer persistence",
    "stateWrites": "single authoritative writer fenced by durable epoch and revision",
    "externalEffects": "at-least-once with idempotency/outbox; timeout means OutcomeUnknown",
    "replicas": "bounded async stream; consumer cursor advances with durable projection",
    "crdt": "explicit audited types only; not arbitrary structs",
