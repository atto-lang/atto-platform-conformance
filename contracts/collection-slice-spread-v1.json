{
  "schema": "atto.collection-slice-spread.v1",
  "version": 1,
  "status": "TARGET_ONLY_NOT_EXECUTED",
  "spec": "atto-lang/atto-spec/language/collection-slice-spread-v1.md",
  "assertion": "These are proposed semantic vectors, not passing guest tests.",
  "semantics": {
    "negative_indexes": "len + i",
    "slice_end": "exclusive",
    "positive_defaults": [
      0,
      "len",
      1
    ],
    "negative_defaults": [
      "len-1",
      -1,
      -1
    ],
    "explicit_negative_end": "normalizes relative to length, NOT reverse sentinel",
    "zero_stride": "reject",
    "explicit_bounds": "checked no clamping",
    "utf8_string_unit": "Unicode scalar",
    "contiguous_slice": "borrowed read-only view",
    "strided_slice": "borrowed read-only strided view",
    "spread": "one evaluation and explicit materialization, ownership checked",
    "infinite_iterable": "no implicit materialization"
  },
  "cases": [
    {
      "id": "idx-first",
      "category": "index",
      "source": "pub fnc main(): int { val a = [10,20,30,40,50]; val x = a[0]; return 0; }",
      "expected_parse": "ACCEPT",
      "expected_value": 10,
      "guest_status": "NOT_EXECUTED"
    },
    {
      "id": "idx-last",
      "category": "index",
