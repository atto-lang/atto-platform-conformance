{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oreslang.dev/contracts/actor-tree/v1/typed-pipeline-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "direction",
    "from",
    "to",
    "hopIndex",
    "schemaHash",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "forward",
        "backward"
      ]
    },
    "from": {
      "$ref": "#/$defs/identity"
    },
    "to": {
      "$ref": "#/$defs/identity"
    },
    "hopIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "schemaHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "payload": {
      "$ref": "#/$defs/taggedI64"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "actorId",
        "incarnation"
      ],
      "properties": {
        "runtimeId": {
          "type": "string",
          "minLength": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "incarnation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "taggedI64": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "value"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    }
  }
}
