    Signal.Result
end

define actor Source<messages=PipeMessages> as
    let result: int = 0;
    receive(Message m) {
        do match m over {
            on Signal.Data as n {
                self.forward(Signal.Data(n));
            }
            on Signal.Result as n {
                result = n;
            }
        }
        return result;
    }
end

define actor Transform<messages=PipeMessages> as
    let value: int = 0;
