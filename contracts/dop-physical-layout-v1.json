  "semantics": {
    "aos": "One record per row, C-like field-aligned record stride, final tail padding.",
    "soa": "One aligned segment per field, field scalar stride aligned to its own alignment.",
    "aosoa": "Single segment of fixed-lane tiles, one contiguous lane array per field in each tile; padded final tile.",
    "soaos": "Explicit nonempty partition of fields into independent record-array segments, each group an aligned AoS record, not AoSoA.",
    "address": "Each row/field maps to exactly one segment and byte offset. Absolute offset = segment.base + relative byte offset. Every cell range is within its segment.",
    "ownership": "Layout descriptor is not a capability to access memory. Actor ownership/borrow exclusivity must be established separately.",
    "future": "Guest parser, HIR/MIR integration and native/JVM codegen are NOT_EXECUTED. Host planners do not prove physical guest lowering.",
    "fieldNames": "Opaque, nonempty well-formed Unicode scalar strings; no NUL; maximum 1024 UTF-8 bytes; exact-codepoint duplicate detection, without Unicode normalization. Source-level identifier admission is separate."
  },
  "negativeInputs": [
