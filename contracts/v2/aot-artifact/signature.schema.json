{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "algorithm",
    "key_id",
    "signature_base64"
  ],
  "properties": {
    "schema_version": {
      "const": "atto.aot-artifact-signature.v2"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "algorithm": {
      "const": "ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atto:aot-artifact-signature:v2",
  "title": "AttoLang AOT V2 detached Ed25519 envelope"
}
