    {
      "id": "class-field",
      "decision": "implicit val; explicit let for rebinding; mut for referent access",
      "canonical": "contracts/class-field-binding-defaults-v2.json"
    },
    {
      "id": "trap",
      "decision": "Result; catch ordinary throw in trap expression, bypass raise/panic/cancel",
      "canonical": "contracts/v2/trap-result-v2.json",
      "historical": "contracts/v1/caller-trap-parity/manifest.json"
    },
    {
      "id": "tenant",
      "decision": "untrusted same-process guests require independently verified TenantVM isolation, not mandatory separate OS process",
      "canonical": "contracts/tenant-isolation-v2.json"
    },
    {
      "id": "caret-xor",
      "decision": "^ return; ^^ integer XOR; Boolean Xor(bool,bool); never infix ^",
      "related": "atto-spec #143"
    },
    {
      "id": "shift",
      "decision": "shift distance 0..63, else language-level checked failure; Java/LLVM native error mapping pending"
    },
    {
      "id": "actor-state",
      "decision": "sealed state via checked critical read/write callbacks, including in receive; construction initialized separately"
    },
    {
      "id": "match",
      "decision": "all match arms require on; wildcard on _; default switch only",
      "related": "atto-platform-conformance #234"
    },
    {
      "id": "division",
      "decision": "int/int yields floating result; explicit integer div_trunc as named API; exact library spelling pending"
    },
    {
      "id": "return-first",
      "decision": "both contiguous <- and exact U+2022 •; identical callable semantics",
      "canonical": "contracts/v2/return-first-separators-v1.json"
    },
    {
      "id": "imports",
      "decision": "unified import * as x from +/pkg; legacy import module compatibility only"
    }
  ],
