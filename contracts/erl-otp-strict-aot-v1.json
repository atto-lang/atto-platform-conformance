  "operatorPolicy": {
    "equality": "eq",
    "inequalityCanonical": "neq",
    "inequalityAlias": [
      "!eq"
    ],
    "invalid": [
      "==",
      "!=",
      "=:=",
      "=/=",
      "/="
    ],
    "assignmentIsPatternMatch": false,
    "noImplicitNumericCoercion": true,
    "logicalOperators": "retain independently ratified AttoLang grammar"
  },
  "functionClauseMatching": {
    "status": "DEFERRED",
    "reason": "static decision-DAG design, effects/ownership, exhaustive guards and code-size policy require separate review",
    "admission": "reject-until-implemented"
  },
  "strictAot": {
    "required": true,
    "guestCodeCompiled": true,
    "runtimeJitAllowed": false,
    "runtimeGuestCompilerAllowed": false,
    "interpreterFallbackAllowed": false,
    "reflectionDispatchAllowed": false,
    "unsupportedFeature": "reject-before-executable-artifact",
    "javaNativeImageOfInterpreterIsNotProof": true,
    "wasmHostJitIsNotProof": true,
    "jsTranspilationIsNotNativeAotProof": true
  },
  "evidencePolicy": {
    "noPromotionFrom": [
      "source-only",
      "host-only",
      "fake-compiler",
      "zero-step-ci",
      "declared-sha-only",
      "stub-aot"
    ],
    "required": [
      "exact-head-sha",
      "tree-sha",
      "compiler-digest",
      "fixture-digest",
      "executable-guest-steps",
      "negative-diagnostics",
      "aot-fallback-rejection",
      "independent-review"
    ]
  },
