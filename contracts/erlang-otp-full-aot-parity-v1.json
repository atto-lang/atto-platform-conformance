    },
    {
      "id": "comprehensions",
      "priority": "P1",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Typed loops/builders with static generator types, no runtime evaluation"
    },
    {
      "id": "otp_server_state_machine",
      "priority": "P1",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Guest stdlib actor base classes and compile-time state/message dispatch"
