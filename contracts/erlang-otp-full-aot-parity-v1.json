{
  "schema": "attolang.erlang_otp.full_aot_parity.v1",
  "version": 1,
  "status": "DRAFT_SOURCE_CONTRACT_NOT_GUEST_EXECUTION",
  "purpose": "Capability equivalence with Erlang/OTP without BEAM, runtime guest interpretation, dynamic guest compilation, or actor isolation regressions.",
  "operator_contract": {
    "equality": "eq",
    "inequality": "neq",
    "inequality_alias": "!eq",
    "short_circuit_logic": "PRESERVE_EXISTING_ATTO_GRAMMAR",
    "no_implicit_numeric_cross_type_coercion": true,
    "match_is_not_equality": true,
    "canonical_forbidden_spellings": [
      "==",
      "!=",
      "=:=",
      "/=",
      "=/="
    ],
    "legacy_migration": "Legacy fixtures may use noncanonical spellings: migrate source, update all pinned blob SHA and expected compiler diagnostics in coordinated PRs; do not silently rewrite."
  },
  "aot_policy": {
    "no_runtime_guest_ast_interpretation": true,
    "no_runtime_guest_jit": true,
    "no_runtime_guest_code_generation": true,
    "no_reflection_based_guest_dispatch": true,
    "static_message_descriptors": true,
    "static_callable_targets": true,
    "precompiled_versioned_hot_loading_only": true,
    "backend_modes": {
      "java": "Program-specific GraalVM Native Image AOT with statically reachable guest functions",
      "llvm": "LLVM compiled machine code with full guest semantics",
      "net": "NativeAOT generated machine code; no DynamicMethod/Reflection.Emit",
      "wasm": "Precompiled WebAssembly guest module; no JS shadow-language interpreter",
      "forge": "Forge native AOT artifact; JIT results are not AOT parity evidence"
    }
  },
  "feature_plan": [
    {
      "id": "operators_equality",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Typed intrinsic operations; eq compares values, neq and !eq are equivalent; no implicit cross-type coercion"
    },
    {
      "id": "pattern_matching",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Exhaustive static match decision DAG from match/over/on/default; no runtime match reflection"
    },
    {
      "id": "typed_guards",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Compile-time pure boolean CFG; no mutation, suspension or hidden dynamic lookup"
    },
    {
      "id": "binary_patterns",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Compile-time-known bit segments, endian/signedness and checked-width extraction; bounded runtime lengths"
    },
    {
      "id": "closures",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Generated concrete capture structs and direct or finite-table indirect call targets"
    },
    {
      "id": "typed_actor_messages",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Statically generated message discriminants, schemas and actor method dispatch"
    },
    {
      "id": "selective_receive",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Statically compiled matcher predicates with bounded mailbox scan and original-order retention"
    },
    {
      "id": "monitors_links_registration",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
      "aot_lowering": "Typed CONTROL notices, generation-fenced identities and capability-scoped registries"
    },
    {
      "id": "scheduler_fairness",
      "priority": "P0",
      "status": "PLANNED_NOT_EXECUTED",
