{
  "schema": "atto.eleven-backend-cross-contract-parity.v1",
  "snapshot_date": "2026-11-20",
  "source_of_truth": "atto-lang/atto-spec",
  "conformance_authority": "atto-lang/atto-platform-conformance",
  "evidence_gate": "source_inventory_only",
  "release_qualified": false,
  "notes": "Main SHAs are observed GitHub snapshots, not tested compiler heads. Candidate PR links are work pointers, not compiled-guest evidence. This registry cannot graduate any cell to passed until a reviewed authenticating verifier and exact-head guest receipts are integrated. Floating int/int division is tracked independently: Java #66 and .NET #191 are unexecuted implementation candidates; all other backends remain not_executed rather than implicitly supported. Rust #411 now proposes typed float division and checked shifts in the actual Rust-to-Wasm frontend; JS #46 proposes checked shift-count guest lowering. Both remain unexecuted, and JS #71 integration must refresh its pinned #46 head.",
  "workstreams": [
    {
      "id": "operator_caret_xor",
      "title": "Canonical ^ statement return and ^^ signed integer XOR",
      "reference": "https://github.com/atto-lang/atto-spec/pull/143",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "checked_i64",
      "title": "Canonical checked signed-i64 arithmetic and constant overflow",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/pull/235",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "float_int_division",
      "title": "Canonical int / int yields float; never silently truncate signed integer division",
      "reference": "https://github.com/atto-lang/atto-spec/pull/151",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "inline_sync_task",
      "title": "Pure inline sync task with void-only do form",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/pull/115",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "trap_result",
      "title": "trap returns Result and preserves raise/panic/host-fault boundaries",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/pull/68",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "functional_pipelines",
      "title": "Pure |> and <| functional pipeline guests",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/pull/112",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "sealed_actor_state",
      "title": "Inline and attached actor state, guards and denial of escape",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/pull/113",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "pointer_ownership",
      "title": "Typed Pointer and capability-scoped borrow/take/reference semantics",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/issues/63",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "tenant_vm_isolation",
      "title": "Mutually untrusted tenant memory, scheduler, I/O and lifecycle siloing",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/issues/216",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "permissions_io",
      "title": "Deno-style I/O permission admission and authority isolation",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/issues/107",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    },
    {
      "id": "module_imports",
      "title": "Project-root + imports and package/module source identity",
      "reference": "https://github.com/atto-lang/atto-platform-conformance/issues/131",
      "approval_state": "candidate_or_tracking",
      "support_claim": "none"
    }
  ],
