{
  "schema": "atto.core-option-borrow-parity.v1",
  "snapshot_date": "2026-11-22",
  "registry_dependency": "contracts/eleven-backend-parity-v1/core-option-dashboard.json",
  "normative_reference": "https://github.com/atto-lang/atto-spec/blob/main/language/ownership-vocabulary-v1.md",
  "scope": "core/option+core/result",
  "evidence_policy": "SOURCE_ONLY_NON_PROMOTING",
  "release_qualified": false,
  "notes": "Cases are conformance targets, not executed guest results. Java owns additional borrowed-query source adapters and negative compiler JUnit tests; all eleven backends must independently enforce affine ownership, lifetimes and conditional drop with backend-specific code.",
  "cases": [
    {
      "id": "borrowed_option_some_query",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Read only Option.Some tag without moving its owner",
      "diagnostic_class": null
    },
    {
      "id": "borrowed_option_none_query",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Read only Option.None tag without moving its owner",
      "diagnostic_class": null
    },
    {
      "id": "borrowed_result_ok_query",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Read only Result.Ok tag without moving its owner",
      "diagnostic_class": null
    },
    {
      "id": "borrowed_result_err_query",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Read only Result.Err tag without moving its owner",
      "diagnostic_class": null
    },
    {
      "id": "owner_survives_loan",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Return from scoped borrow, then use the original owner",
      "diagnostic_class": null
    },
    {
      "id": "borrowed_affine_flatten",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed nested Option must not yield an owned affine inner value",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "borrowed_affine_option_unwrap",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed Option must not yield an owned affine payload",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "borrowed_affine_result_unwrap",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed Result must not yield an owned affine payload",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "borrowed_affine_safe_repackage",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed Option must not repackage an affine owner",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "borrowed_affine_fallback",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed Option unwrap_or cannot launder an affine owner",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "copyable_nested_borrow",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Borrowed Copy nested Option may be read without moving the carrier",
      "diagnostic_class": null
    },
    {
      "id": "loan_then_move",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Moving an owner during an outstanding loan must be rejected",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "borrowed_escape",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Borrowed owner must not outlive the original owner",
      "diagnostic_class": "borrow-or-ownership"
    },
    {
      "id": "inactive_variant_drop_once",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Consuming zip or transpose must drop unused affine variant exactly once",
      "diagnostic_class": null
    },
    {
      "id": "callback_exactly_once",
      "expected": "accept",
      "kind": "compiled_guest",
      "requirement": "Map and error callbacks run at most once and skip inactive variants",
      "diagnostic_class": null
    },
    {
      "id": "suspend_with_live_loan",
      "expected": "reject",
      "kind": "compiler_negative",
      "requirement": "Live borrow cannot cross unsupported suspend or actor handoff",
      "diagnostic_class": "borrow-or-ownership"
    }
  ],
