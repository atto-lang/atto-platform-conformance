          "init",
          "x",
          "move"
        ],
        [
          "borrow_shared",
          "x",
          "r1"
        ],
        [
          "borrow_shared",
          "x",
          "r2"
        ],
        [
          "release",
          "r1"
        ],
        [
          "release",
          "r2"
        ],
        [
          "return"
        ]
