          "init",
          "x",
          "copy"
        ],
        [
          "copy",
          "x",
          "y"
        ],
        [
          "read",
          "x"
        ],
        [
          "read",
          "y"
        ],
        [
          "return"
        ]
      ],
      "expected": "OK"
