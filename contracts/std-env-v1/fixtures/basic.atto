// Controlled env: ATTO_ENV_VALUE=42, ATTO_ENV_EMPTY="" and ATTO_ENV_MISSING absent.
import module std_env from "std/env";
pub routine main(): void {
  stdio.println(std_env.get_required("ATTO_ENV_VALUE").unwrap());
  stdio.println(std_env.has("ATTO_ENV_EMPTY"));
  stdio.println(std_env.get("ATTO_ENV_EMPTY").unwrap() == "");
  stdio.println(std_env.get_nonempty("ATTO_ENV_EMPTY").is_none());
  stdio.println(std_env.get_or("ATTO_ENV_MISSING", "fallback"));
  return;
}
