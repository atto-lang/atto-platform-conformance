{
  "schema_version": "1.0.0-design",
  "status": "SOURCE_FREE_POLICY_MODEL_NOT_COMPILER_PARITY",
  "language_scope": "Oreslang proposed declaration kinds and nominal hierarchy admission",
  "baseline_backends": [
    "java",
    "llvm",
    "wasm",
    "cranelift",
    "net",
    "forge"
  ],
  "backend_execution": {
    "java": "NOT_EXECUTED",
    "llvm": "NOT_EXECUTED",
    "wasm": "NOT_EXECUTED",
    "cranelift": "NOT_EXECUTED",
    "net": "NOT_EXECUTED",
    "forge": "NOT_EXECUTED"
  },
  "rules": {
    "class": {
      "parent_kinds": [
        "class"
      ],
      "max_parents": 1,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 0,
      "ordinary_fields": true
    },
    "actor": {
      "parent_kinds": [
        "actor"
      ],
      "max_parents": 1,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 1,
      "ordinary_fields": false,
      "isolation": "preserve",
      "role": "message"
    },
    "supervisor": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": false,
      "guest_state_blocks": 1,
      "ordinary_fields": false,
      "role": "control",
      "privileged": true
    },
    "grain": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 1,
      "ordinary_fields": false,
      "identity_key": true,
      "role": "virtual-actor"
    },
    "state_container": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 1,
      "ordinary_fields": false,
      "role": "synchronous-owned"
    },
    "model": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": false,
      "guest_state_blocks": 0,
      "ordinary_fields": false,
      "role": "immutable-graph"
    },
    "enum": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 0,
      "ordinary_fields": false,
      "role": "tagged-value"
    },
    "struct": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 0,
      "ordinary_fields": true,
      "role": "owned-value"
    },
    "record": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": true,
      "traits": true,
      "guest_state_blocks": 0,
      "ordinary_fields": true,
      "role": "immutable-value"
    },
    "interface": {
      "parent_kinds": [
        "interface"
      ],
      "max_parents": 32,
      "interfaces": false,
      "traits": false,
      "guest_state_blocks": 0,
      "ordinary_fields": false,
      "role": "type-only"
    },
    "trait": {
      "parent_kinds": [
        "trait"
      ],
      "max_parents": 32,
      "interfaces": false,
      "traits": false,
      "guest_state_blocks": 0,
      "ordinary_fields": false,
      "role": "type-only"
    },
    "protocol": {
      "parent_kinds": [],
      "max_parents": 0,
      "interfaces": false,
      "traits": false,
      "guest_state_blocks": 0,
      "ordinary_fields": false,
      "role": "wire-schema"
    }
  },
  "semantics": {
    "one_concrete_superclass": true,
    "no_trait_owned_storage": true,
    "interfaces_never_grant_capabilities": true,
    "runtime_capabilities_compiler_owned": true,
    "no_state_loan_escape": true,
    "no_state_loan_across_suspend": true,
    "prohibit_actor_direct_state_access": true,
    "prohibit_forged_supervisor_control": true,
    "sealed_intrinsic_hooks_nonoverridable": true,
    "no_implicit_class_actor_grain_conversion": true,
    "trait_and_interface_are_nominally_distinct": true,
    "state_container_lifetime": "bound_to_owner_no_implicit_spawn_or_network",
    "grain_lifetime": "keyed_actor_activation_epoch_fenced"
  },
  "test_cases": [
    {
