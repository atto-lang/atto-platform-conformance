      "kind": "class",
      "options": {},
      "expected": "OK"
    },
    {
      "id": "C02",
      "kind": "class",
      "options": {
        "parents": [
          {
            "kind": "class"
          }
        ]
      },
      "expected": "OK"
    },
    {
