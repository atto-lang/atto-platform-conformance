{
  "schema": "attolang.gpu-cuda-parity-map/1",
  "scope": "GPU programming ecosystem benchmark: low-level kernels, ergonomic logical launches and proposed high-level/tile features",
  "assertsProductionCudaParity": false,
  "evidencePolicy": {
    "compilerGuestAndDeviceHardwareRequired": true,
    "sourceBlobAndTreeIdentityRequired": true,
    "nonzeroExecutedRunnerStepsRequired": true,
    "hostOnlyResultsMayNotPromote": true,
    "zeroStepEvidence": "RUNNER_ADMISSION_FAILURE",
    "backendFallback": "FORBIDDEN"
  },
  "phases": {
    "P0": "first compiler-backed launch with real device",
    "P1": "core SIMT/memory/synchronization",
    "P2": "advanced accelerator runtime and math",
    "P3": "optional vendor-specific capabilities, explicit no-fallback"
  },
  "providers": [
    "nvidia-cuda",
    "amd-rocm",
    "vulkan-spirv",
    "apple-metal",
    "webgpu"
  ],
