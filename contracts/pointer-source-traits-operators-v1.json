{
  "schema": "atto.pointer-source-traits-operators.v1",
  "status": "TARGET_ONLY_NOT_EXECUTED",
  "normative_source": "atto-lang/atto-spec#18",
  "description": "Operator disambiguation and built-in Pointer<T> trait coherence across all eleven compiler backends; no compiled guest conformance is asserted.",
  "rule": "Unary &/unary * are forbidden address-of/deref; binary & is integer bitwise AND and binary * is multiplication. rt/bang pointer forms are equivalent checked operations.",
  "nominal_type": {
    "name": "Pointer<T>",
    "builtin": true,
    "invariant": true,
    "non_forgeable": true,
    "shadowable": false,
    "separate_from": "CheckedRef<Class>",
    "authority_states": [
      "BorrowedLocal<T>",
      "OwnedRegion<T>"
    ]
  },
  "implicit_traits": {
    "Copy": false,
    "Clone": false,
    "Sendable": false,
    "Serializable": false,
    "Shareable": false
  },
  "transport": "No raw pointer cross tenant, actor, isolate, worker or network. Explicit checked same-domain capability transfer requires separate proof and admission.",
  "cases": [
    {
      "id": "PTO-001",
      "kind": "EXECUTE",
