define struct Particle {
    x: int;
    y: int;
    velocity: int;
}

fnc layout_soa_mutation() -> int {
    let particles: Array<Particle, layout=soa> = [
        Particle(x=1, y=2, velocity=3),
        Particle(x=4, y=5, velocity=6)
    ];
    particles[0].x += 10;
    return particles.columns.x[0];
}
