{
  "schema": "atto.conformance.mutex-async-lease.v1",
  "version": 1,
  "status": "TARGET_SOURCE_ONLY_NOT_EXECUTED",
  "authority": "https://github.com/atto-lang/atto-spec/blob/main/language/mutex-async-lease-and-suspension-v1.md",
  "fixtures_dir": "fixtures/mutex-async-lease-v1",
  "source_only_warning": "No backend may report PASS from fixture integrity or accepted syntax; the guest must be compiled and executed and all negatives rejected without artifacts.",
  "cases": [
    {
      "id": "ready-await-no-forced-yield",
      "kind": "compiled_guest_positive",
      "source": "ready-await-no-forced-yield.atto",
      "feature": "await",
      "expected_stdout": "42\n",
      "expected_exit": 42,
      "expected_runtime_suspensions": 0
    },
    {
      "id": "fast-implicit-using",
      "kind": "compiled_guest_positive",
      "source": "implicit-await-fast-path.atto",
      "expected_stdout": "1\n",
      "expected_exit": 0,
      "expected_runtime_suspensions": 0
    },
    {
      "id": "fast-explicit-using",
      "kind": "compiled_guest_positive",
      "source": "explicit-await-fast-path.atto",
      "expected_stdout": "1\n",
      "expected_exit": 0,
      "expected_runtime_suspensions": 0
    },
    {
      "id": "lazy-unawaited",
      "kind": "compiled_guest_positive",
      "source": "lazy-unawaited-task.atto",
      "expected_exit": 0,
      "expected_acquisitions": 0
    },
    {
      "id": "reject-await-effect",
      "kind": "compile_negative",
      "source": "negative-await-effect.atto",
      "expected_diagnostic": "E_AWAIT_EFFECT",
      "guest_artifact": false
    },
    {
      "id": "reject-guard-suspend",
      "kind": "compile_negative",
      "source": "negative-guard-suspend.atto",
      "expected_diagnostic": "E_GUARD_SUSPEND",
      "guest_artifact": false
    },
    {
      "id": "reject-guard-ready-await",
      "kind": "compile_negative",
      "source": "negative-guard-ready-await.atto",
      "feature": "mutex",
      "expected_diagnostic": "E_GUARD_SUSPEND",
      "guest_artifact": false
    },
    {
      "id": "reject-guard-escape",
      "kind": "compile_negative",
      "source": "negative-guard-escape.atto",
      "expected_diagnostic": "E_GUARD_ESCAPE",
      "guest_artifact": false
    },
    {
      "id": "contention-nonparking",
      "kind": "runtime_probe",
      "expected": "On carrier A, an independent holder owns the lease without suspending inside its critical section. On carrier B, Task B's contended lock_async() parks only B's logical continuation; an unrelated Task C completes on carrier B before A releases. After A releases, B receives one grant. No blocked carrier or unbounded spin.",
      "evidence_required": true,
      "probe_carriers": 2,
      "required_order": [
        "A_ACQUIRE",
        "B_PENDING",
        "C_PROGRESS",
        "A_RELEASE",
        "B_GRANTED",
        "B_RELEASE"
      ],
      "fail_if": [
        "A_AWAIT_INSIDE_GUARD",
        "C_PROGRESS_AFTER_A_RELEASE",
        "SCHEDULER_CARRIER_BLOCKED",
        "DUPLICATE_GRANT"
      ]
    },
    {
      "id": "cancellation-grant-race",
      "kind": "runtime_probe",
      "expected": "Exactly one of cancellation or lease grant is terminal; no orphan waiter or double release; guard acquired on winning path is disposed exactly once",
      "evidence_required": true
    },
    {
      "id": "return-throw-raise-cleanup",
      "kind": "runtime_probe",
      "expected": "One permit cleanup for each supported normal or exceptional exit, not at suspension while waiting",
      "evidence_required": true
    },
    {
      "id": "reentrancy-and-replay",
      "kind": "runtime_probe",
      "expected": "Recursive current-continuation acquisition and stale generation/lease token reuse fail closed",
      "evidence_required": true
    },
    {
      "id": "actor-tenant-isolation",
      "kind": "runtime_probe",
      "expected": "Local Mutex handle and guard cannot cross actor/TenantVM boundary; unauthorized SharedMutex cannot escape security policy",
      "evidence_required": true
    },
    {
      "id": "sync-lock-would-block",
      "kind": "runtime_probe",
      "expected": "lock() never parks carrier; contention reports typed would-block; try_lock yields None",
      "evidence_required": true
    },
    {
      "id": "legacy-async-2-abi-rejection",
      "kind": "runtime_probe",
      "expected": "A guest compiled against mandatory-yield atto.async/2 must not be silently reinterpreted as conditional-ready await; host must reject unsupported ABI, and the new ABI needs a separate version",
      "evidence_required": true
    },
    {
      "id": "unawaited-call-vs-scheduled-task",
      "kind": "runtime_probe",
      "expected": "Calling susp function creates lazy task without side effects; explicitly scheduling a child task may start it before first await; cancellation and parentage are tracked independently",
      "evidence_required": true
    },
    {
      "id": "two-sequential-ready",
      "kind": "compiled_guest_positive",
      "source": "two-sequential-ready.atto",
      "expected_exit": 2,
      "expected_runtime_suspensions": 0,
      "expected_sequential_acquisitions": 2,
      "expected_releases": 2
    },
    {
      "id": "reject-guard-overflow",
      "kind": "compile_negative",
      "source": "negative-guard-overflow.atto",
      "expected_diagnostic": "E_OVERFLOW",
      "guest_artifact": false
    }
  ],
