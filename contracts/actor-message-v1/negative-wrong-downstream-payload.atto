// Candidate negative: accepted text recipient does not widen integer recipient.
define actor TextSink receives String as
  receive(ActorMail<String> mail): void { return; }
end
define actor NumberSink receives int as
  receive(ActorMail<int> mail): void { return; }
end
pub routine main(): void {
  val text_sink = spawn TextSink();
  val count_sink = spawn NumberSink();
  text_sink.send("ok");
  count_sink.send("wrong type");
  return;
}
