  "notes": "This registry records source targets. Local receipts for scalar and Option callable results are recorded in the compiler PRs. The normal .NET CLI compiles guarded standalone guests through the verified CFG. Backend status here requires the registry’s separate exact-head workflow proof.",
  "return_contract": {
    "condition": "strict bool; short circuit left to right; evaluated once per test",
    "true_path": "continue after guard",
    "false_path": "execute failure block; every path must explicitly return from enclosing function",
    "disallowed_substitutes": [
      "throw",
      "raise",
      "panic",
      "break",
      "continue"
    ],
    "type_rule": "return expression matches enclosing function result; in void functions ^ void/return void are contextual no-value returns and reject in nonvoid callables",
    "evidence": "no compiler or guest parity certified without exact-head executed stepful receipts"
  },
