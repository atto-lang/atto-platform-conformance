    "condition": "strict bool; short circuit left to right; evaluated once per test",
    "true_path": "continue after guard",
    "false_path": "execute failure block; every path must explicitly return from enclosing function",
    "disallowed_substitutes": [
      "throw",
      "raise",
      "panic",
      "break",
      "continue"
    ],
    "type_rule": "return expression statically checked against enclosing function return type; void uses return",
