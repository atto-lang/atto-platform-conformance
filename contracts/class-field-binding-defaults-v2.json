    "referent_mutation": "mut requests independently checked referent-write authority, never implicit name rebinding",
    "val": "binding fixed, runtime initializer permitted within supported effect profile",
    "final": "exactly one initialization; deferred assignment only with definite-assignment proof",
    "const": "compile-time-evaluable class field; no file/module runtime os.read_env exception",
    "legacy_named_fields": "keep existing semantics pending separate migration",
    "locals": "type-first local shorthand retains const, not implicit val",
    "package_access": "private class-only; pub[pkg] authenticated declaring package only; pub exposed if declaring type accessible",
