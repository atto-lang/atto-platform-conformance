  "source_syntax_status": "proposed: @QualifiedName(positional, named: value); current parser syntax varies",
  "rules": {
    "unknown_semantic_annotations": "reject",
    "duplicate_without_registered_repeatability": "reject",
    "arguments": "closed typed constant expressions; no I/O, clocks, randomness, mutable state or executing guest code",
    "macro_phase": "hygienic AOT expansion before type/ownership/effect checks, then full recheck",
    "authorization": "annotations can require capabilities but never grant them",
    "effects": "keywords critical and suspends remain authoritative; annotations must not override effects",
    "runtime_retention": "none by default; explicit, versioned, nonreflective metadata sections only after backend proof",
    "backend_policy": "unsupported annotations must reject before IR or artifact publication",
    "incremental_hot_reload": "bind fingerprint, declaration version, expanded IR, ownership/effect proof dependencies",
    "transport": "function, method, closure, capability objects never become Sendable via annotations",
    "evidence": "exact source/compiler head and trees, nonzero job steps, compiler-backed negative and positive tests, independent review"
  },
  "evidence": {
    "java": "NOT_EXECUTED",
    "llvm": "NOT_EXECUTED",
    "net": "NOT_EXECUTED",
