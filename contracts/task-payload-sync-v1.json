  "verification": "Source-only registry; requires exact compiler SHA, negative no-artifact proofs, actual guest execution and independent backend receipts.",
  "cancellation_model": "owned Future<T>.cancel(): void requests nonblocking idempotent cancellation; TaskCancelled terminal distinct from success/failure; scope cascades and physically retires all children; receipt witnesses mandatory",
  "lock_cancellation_model": "Cancel request != lock release != task retirement. Queued waiter revokes without a guard; active lease never releases until holder safe-point cleanup; exactly-once LIFO release; no child join under live guard; cleanup failures retain fenced ownership and block DONE.",
  "lock_cancellation_runtime_probes": [
    {
      "id": "queued_wait_cancel",
      "given": [
        "task_A_holds_lock",
        "task_B_queued"
      ],
      "action": "cancel_task_B",
      "required_order": [
        "A_LOCK_CLAIM",
        "B_WAIT",
        "B_CANCEL_WAIT",
        "A_LOCK_RELEASE"
      ],
      "assertions": [
        "B_NO_GRANT",
        "NO_CARRIER_PARK",
        "NO_ORPHAN_WAIT_TICKET",
        "B_TERMINAL_AFTER_WAIT_SETTLED",
        "CANCEL_WAKE_LEVEL_TRIGGERED_UNTIL_TRUSTED_EXIT",
        "CANCELLED_WAIT_HAS_NO_GUARD_RELEASE"
      ],
      "notification_contract": "TaskScope cancellation must make a queued task runnable to observe TaskCancelled, with durable level-triggered notice until trusted execution exit and no acquired-guard release."
    },
    {
      "id": "grant_cancel_race",
      "given": [
        "task_A_releasing",
        "task_B_waiting",
        "task_C_waiting"
      ],
      "action": "cancel_task_B_at_handoff",
      "assertions": [
        "ONE_TERMINAL_CLAIM_B",
        "B_NEVER_USES_REVOKED_LEASE",
        "ONE_VALID_GRANT_TO_C",
        "NO_STALE_WAKE",
        "NO_DUPLICATE_RELEASE",
        "GRANT_WAKE_SURVIVES_FAILED_SCHEDULER_ENQUEUE",
        "ACK_ONLY_AFTER_READY_QUEUE_ADMISSION",
        "STALE_ACK_CANNOT_CLEAR_SUCCESSOR_WAKE",
        "CLAIM_REVALIDATES_AFTER_ACK"
      ],
      "notification_contract": "Grant hints are level-triggered pending notifications, not lease capabilities. Only a trusted scheduler may acknowledge after successful ready-queue admission. Failed enqueue leaves hint visible; late or stale ack must not clear a successor's hint. Lease claim rechecks generation/owner/cancellation."
    },
    {
      "id": "active_guard_cancel",
      "given": [
        "task_A_inside_guard",
        "task_B_waiting"
      ],
      "action": "cancel_task_A",
      "required_order": [
        "A_LOCK_CLAIM",
        "A_CANCEL_REQUEST",
        "A_SAFE_POINT_UNWIND",
        "A_LOCK_RELEASE",
        "A_PHYSICAL_RETIRE"
      ],
      "assertions": [
        "NO_EARLY_UNLOCK",
        "ONE_RELEASE",
        "NO_USE_AFTER_RELEASE",
        "A_DONE_AFTER_CLEANUP_AND_CALLBACK_DRAIN"
      ],
      "happens_before": [
        [
          "A_LOCK_RELEASE",
          "B_LOCK_CLAIM"
        ],
        [
          "A_LOCK_RELEASE",
          "A_PHYSICAL_RETIRE"
        ]
      ]
    },
    {
      "id": "nested_guards_lifo",
      "given": [
        "task_A_holds_lock_1_then_lock_2"
      ],
      "action": "cancel_task_A",
      "required_order": [
        "A_GUARD_2_RELEASE",
        "A_GUARD_1_RELEASE",
        "A_PHYSICAL_RETIRE"
      ],
      "assertions": [
        "ONE_RELEASE_PER_CLAIM",
        "NO_LOST_LEASE"
      ]
    },
    {
      "id": "parent_guard_child_join_deadlock",
      "given": [
        "parent_holds_lock",
        "child_waits_same_lock"
      ],
      "action": "parent_scope_cancel_and_exit",
      "required_order": [
        "PARENT_GUARD_RELEASE",
        "CHILD_PHYSICAL_RETIRE",
        "PARENT_PHYSICAL_RETIRE"
      ],
      "assertions": [
        "NO_JOIN_UNDER_GUARD",
        "NO_CARRIER_BLOCK"
      ]
    },
    {
      "id": "cleanup_failure_fence",
      "given": [
        "task_A_has_active_lease",
        "host_cleanup_fails"
      ],
      "action": "cancel_task_A",
      "assertions": [
        "TASK_NOT_MARKED_PHYSICALLY_RETIRED",
        "LOCK_NOT_REGRANTED",
        "FAILURE_CAUSE_RETAINED",
        "INDEPENDENT_GUARDS_ATTEMPTED",
        "TENANT_QUARANTINED_OR_SAFE_RECOVERY"
      ]
    },
    {
      "id": "isolate_hard_stop_host_lease",
      "given": [
        "untrusted_guest_with_host_owned_guard"
      ],
      "action": "terminate_isolated_guest",
      "assertions": [
        "HOST_GENERATION_REVOKED",
        "DOMAIN_QUIESCENCE_PROVEN_BEFORE_REUSE",
        "NO_GUEST_DEFER_ASSUMED",
        "NO_CROSS_TENANT_LEASE_REPLAY"
      ]
    },
    {
      "id": "rwlock_cancel_read_write",
      "given": [
        "two_active_read_guards",
        "writer_waiting"
      ],
      "action": "cancel_one_reader_then_cancel_writer",
      "required_order": [
        "READER_1_UNWIND_RELEASE",
        "WRITER_WAIT_CANCELLED",
        "READER_2_UNWIND_RELEASE",
        "SCOPE_PHYSICAL_RETIRE"
      ],
      "assertions": [
        "NO_WRITER_GRANTED_BEFORE_ALL_READERS_RELEASE",
        "READ_COUNT_NEVER_NEGATIVE",
        "NO_WRITER_PERMIT_AFTER_CANCEL",
        "NO_DUPLICATE_READ_RELEASE",
        "NO_STARVED_CANCELLED_WAITER"
      ]
    },
    {
      "id": "actor_critical_write_task_cancel",
      "given": [
        "tenant_actor_owns_critical_write_guard",
        "child_task_cancel_requested"
      ],
      "action": "cancel_task_while_guard_active",
      "assertions": [
        "CRITICAL_WRITE_NOT_REENTRANT",
        "NO_RELEASE_WHILE_HANDLER_STILL_RUNNING",
        "EXACTLY_ONCE_GUARD_CLEANUP",
        "SUPERVISOR_CONTROL_NOT_FORGEABLE",
        "PHYSICAL_RETIRED_AFTER_LEASE_SETTLED",
        "NO_CROSS_TENANT_GRANT"
      ]
    },
    {
      "id": "task_cancel_cross_mutex_ticket_replay",
      "given": [
        "trusted_task_has_grant_for_mutex_A",
        "same_task_has_pending_or_granted_mutex_B",
        "different_lock_generations"
      ],
      "action": "attempt_to_claim_mutex_B_using_mutex_A_ticket",
      "assertions": [
        "NO_CROSS_MUTEX_GRANT",
        "WRONG_TICKET_REJECTED",
        "PER_MUTEX_GENERATION_UNIQUE",
        "NO_ACCESS_TO_OTHER_PROTECTED_MEMORY",
        "NO_DOUBLE_RELEASE"
      ],
      "evidence_required": true
    },
    {
      "id": "tenant_shutdown_claimed_guard",
      "given": [
        "active_lease_claimed_by_task_A",
        "task_B_waiting",
        "host_tenant_stop_requested"
      ],
      "action": "cancel_all_task_scopes_then_close_lock_queues",
      "required_order": [
        "A_LOCK_CLAIM",
        "HOST_TENANT_STOP",
        "B_WAIT_REVOKED",
        "A_SAFE_UNWIND",
        "A_LOCK_RELEASE",
        "TENANT_PHYSICAL_QUIESCENCE"
      ],
      "assertions": [
        "NO_NEW_GRANTS_AFTER_STOP",
        "ACTIVE_LEASE_REMAINS_FENCED_UNTIL_HOLDER_UNWINDS",
        "NO_STALE_WAITER_WAKE",
        "SHUTDOWN_IDEMPOTENT",
        "PHYSICAL_RETIRE_AFTER_CALLBACK_DRAIN"
      ],
      "evidence_required": true
    },
    {
      "id": "successful_parent_scope_exit_cancels_descendants",
      "given": [
        "parent_has_claimed_mutex",
        "child_waits_on_same_mutex",
        "grandchild_unfinished",
        "unrelated_sibling_running"
      ],
      "action": "parent_returns_successfully_without_explicit_child_await",
      "required_order": [
        "PARENT_SUCCESS_CLAIM",
        "CHILD_CANCEL_REQUEST",
        "PARENT_GUARD_RELEASE",
        "CHILD_PHYSICAL_RETIRE",
        "PARENT_PHYSICAL_RETIRE"
      ],
      "assertions": [
        "PARENT_SUCCESS_NOT_REPLACED_BY_CANCELLATION",
