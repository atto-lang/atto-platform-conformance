{
  "schema": "atto.task-payload-sync.v1",
  "status": "TARGET_NOT_GUEST_VERIFIED",
  "source_contract": "atto-lang/atto-spec/language/typed-task-payload-sync-v1.md",
  "meaning": "task<T> returns Future<T> and is independently schedulable; await task<T> spawns and joins; sync task<T> and void-only do sync task<void> execute inline on caller TaskId, without an independent spawn or Future; do task<T> is supervised child spawn; standalone inline void statements require 'do sync task', and do-inline may only return void",
  "execution_frame_model": "independent logical continuations for spawned task<T> within a structured TaskScope; inline sync task runs in its caller's logical continuation and creates no independent child; physical frame sharing only after proven lifetime and alias safety",
