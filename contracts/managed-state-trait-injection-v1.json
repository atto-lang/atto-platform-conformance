{
  "contract": "managed-state-trait-injection-v1",
  "version": "1.0.0-design",
  "status": "SOURCE_FREE_NOT_COMPILER_PARITY",
  "required_backends": [
    "java",
    "llvm",
    "wasm",
    "cranelift",
    "net"
  ],
  "extra_backend": "forge",
  "execution": {
    "java": "NOT_EXECUTED",
    "llvm": "NOT_EXECUTED",
    "wasm": "NOT_EXECUTED",
    "cranelift": "NOT_EXECUTED",
    "net": "NOT_EXECUTED"
  },
  "semantics": {
    "trait_requires_state_slot": true,
    "trait_storage_ownership": false,
    "trait_capability_minting": false,
    "class_scope": "instance",
    "singleton_scope": "application_domain",
    "singleton_initialization": "once-per-domain-sticky-failure",
    "state_sources": [
      "state_block",
      "injected"
    ],
    "actor_supervisor_generic_injection": "rejected-until-separately-verified",
    "guard_modes": [
      "critical-read",
      "critical-write"
    ]
  },
  "promotion": {
    "identical_guest_source_required": true,
    "real_compiler_and_guest_execution_required": true,
    "nonzero_ci_steps_required": true,
    "rejection_counts_as_execution": false,
    "host_reference_counts_as_parity": false
  },
  "cases": [
    {
      "id": "T01_CLASS_INLINE",
      "input": {
        "kind": "class",
        "required_type": "CounterState",
        "bindings": [
          {
            "origin": "state_block",
            "type": "CounterState",
            "initialized": true
          }
        ],
        "access": {
          "mode": "write",
          "guard": "critical-write",
          "mutates": true
        }
      },
      "expected": "OK"
    },
    {
      "id": "T02_SINGLETON_INLINE",
      "input": {
        "kind": "singleton",
        "required_type": "CounterState",
        "bindings": [
          {
            "origin": "state_block",
            "type": "CounterState",
            "initialized": true
          }
        ],
        "access": {
          "mode": "read",
          "guard": "critical-read"
        }
      },
      "expected": "OK"
    },
    {
