{
  "schemaVersion": 1,
  "id": "tail-calls-v1",
  "scope": "cross-backend executable Oreslang semantic conformance",
  "note": "All backend results are pending; source-fixture checking is not native compiler/guest evidence.",
  "backends": [
    "java",
    "llvm",
    "net",
    "wasm",
    "forge"
  ],
  "requirements": {
    "tailPosition": "return of a direct/indirect call, including selected conditional arms, with no outstanding cleanup or handler continuation",
    "recursiveRoutines": "reject direct and indirect reentry, including calls via fncs, methods or callbacks; dynamic edges need a runtime fence",
    "backendsMayImplement": "ABI-safe native tail call, self-loop lowering, or an explicit trampoline",
    "safepoint": "bounded polling on long tail-call chains; preserve cancellation/deadline/fuel",
    "barriers": [
      "defer/finally",
      "catch/exception handler",
      "pending ownership drops",
      "critical region",
      "suspension/await boundary",
      "actor-turn or isolate boundary",
      "generator suspension"
    ],
    "nonTail": "ordinary recursion retains ordinary stack semantics",
    "proof": [
      "exact source/guest fixture hash",
      "exact compiler executable identity",
      "checked and actually executed guest",
      "observable output/diagnostic",
      "bounded peak stack or stack-constant proof",
      "job steps nonempty and bound to exact head"
    ]
  },
