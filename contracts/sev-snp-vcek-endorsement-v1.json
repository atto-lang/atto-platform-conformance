  "security_review_requirements": [
    "AMD published root pin provenance",
    "CRL source and complete chain revocation semantics",
    "additional hardware SNP product layouts",
    "VLEK cloud deployments",
    "real quote collection",
    "ephemeral TLS private-key possession",
    "per-tenant generation anti-replay",
    "adversarial guest isolation"
  ]
