{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "atto.std.assert.v1",
  "upstream_design": "https://github.com/atto-lang/atto-spec/pull/114",
  "scope": "candidate sources only; no guest parity claim",
  "receipt_policy": "NOT_EXECUTED may not be promoted by author-controlled metadata; only independently checked exact-head stepful guest evidence",
  "cases": [
    {
      "id": "true_success",
      "expect": "guest_success",
      "shape": "assert.true(true)"
    },
    {
      "id": "false_success",
      "expect": "guest_success",
      "shape": "assert.false(false)"
    },
    {
      "id": "equal_success",
      "expect": "guest_success",
      "shape": "assert.equal(42, 42)"
    },
    {
      "id": "not_equal_success",
      "expect": "guest_success",
      "shape": "assert.not_equal(42, 43)"
    },
    {
      "id": "true_failure",
      "expect": "typed_AssertionError",
      "shape": "assert.true(false)"
    },
    {
      "id": "false_failure",
      "expect": "typed_AssertionError",
      "shape": "assert.false(true)"
    },
    {
      "id": "equal_failure",
      "expect": "typed_AssertionError",
      "shape": "assert.equal(42, 43)"
    },
    {
      "id": "not_equal_failure",
      "expect": "typed_AssertionError",
      "shape": "assert.not_equal(42, 42)"
    },
    {
      "id": "user_failure_message",
      "expect": "typed_AssertionError",
      "shape": "assert.fail(\"bad invariant\")"
    },
    {
      "id": "eq_mixed_numeric",
      "expect": "compile_error",
      "shape": "assert.equal(42, 42.0)"
    },
    {
      "id": "requires_bool",
      "expect": "compile_error",
      "shape": "assert.true(42)"
    },
    {
      "id": "unbound_module",
      "expect": "compile_error",
      "shape": "assert.true(true) without import"
    },
    {
      "id": "reserved_member_grammar",
      "expect": "compile_success",
      "shape": "qualified true/false only"
    },
    {
      "id": "args_once_left_to_right",
      "expect": "guest_success",
      "shape": "effect-counted expected/actual evaluations"
    },
    {
      "id": "retained_in_release_and_aot",
      "expect": "typed_AssertionError",
      "shape": "false assertion in optimized build"
    },
    {
      "id": "caught_without_actor_supervisor_panic",
      "expect": "typed_AssertionError",
      "shape": "local catch; unrelated actors survive"
    },
    {
      "id": "test_outcome_returns_failure_data",
      "expect": "guest_success",
      "shape": "TestOutcome false with message"
    },
    {
      "id": "bounded_diagnostics",
      "expect": "guest_success",
      "shape": "no secret/leak or unbounded formatter"
    },
    {
      "id": "hdl_synthesis_reject_or_hosted_simulation",
      "expect": "profile_specific",
      "shape": "no silently dropped assertions"
    },
    {
      "id": "hard_realtime_reject_or_bounded_typed_effect",
      "expect": "profile_specific",
      "shape": "no uncontrolled throw/allocation in hard RT"
    }
  ],
