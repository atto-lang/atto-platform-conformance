{
  "schemaVersion": 1,
  "contract": "oreslang.heterogeneous-compute/1",
  "backends": ["java", "llvm", "net", "wasm", "forge", "cranelift", "js"],
  "stages": ["compiler-checked", "guest-executed", "physical-hardware", "deadline-verified"],
  "targetClasses": ["cpu", "gpu", "cluster", "embedded"],
  "features": {
    "data.tensor.dense": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":[]},
    "data.tensor.dynamic_shape": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":["data.tensor.dense"]},
    "data.tensor.sparse": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":["data.tensor.dense"]},
    "data.table.columnar": {"minimumStage":"guest-executed", "targets":["cpu"], "requires":[]},
    "interop.arrow_zero_copy": {"minimumStage":"guest-executed", "targets":["cpu"], "requires":["data.table.columnar", "memory.owned_views"]},
    "interop.dlpack": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["data.tensor.dense", "memory.device_ownership"]},
    "math.autodiff.forward": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":["data.tensor.dense"]},
    "math.autodiff.reverse": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":["data.tensor.dense"]},
    "math.deterministic_reduction": {"minimumStage":"guest-executed", "targets":["cpu","gpu","cluster"], "requires":[]},
    "math.mixed_precision": {"minimumStage":"guest-executed", "targets":["cpu","gpu"], "requires":[]},
    "memory.owned_views": {"minimumStage":"guest-executed", "targets":["cpu","gpu","cluster","embedded"], "requires":[]},
    "memory.device_ownership": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["memory.owned_views"]},
    "memory.numa_placement": {"minimumStage":"physical-hardware", "targets":["cpu"], "requires":["memory.owned_views"]},
    "cpu.simd": {"minimumStage":"guest-executed", "targets":["cpu","embedded"], "requires":[]},
    "cpu.layout_aos_soa": {"minimumStage":"guest-executed", "targets":["cpu","gpu","embedded"], "requires":[]},
    "gpu.kernel": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["memory.device_ownership"]},
    "gpu.async_transfer": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["gpu.kernel", "memory.device_ownership"]},
    "gpu.shared_memory": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["gpu.kernel"]},
    "gpu.tensor_core": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["gpu.kernel", "math.mixed_precision"]},
    "gpu.reusable_graph": {"minimumStage":"physical-hardware", "targets":["gpu"], "requires":["gpu.kernel", "runtime.task_graph"]},
    "distributed.sharding": {"minimumStage":"physical-hardware", "targets":["cluster"], "requires":["memory.owned_views"]},
    "distributed.collectives": {"minimumStage":"physical-hardware", "targets":["cluster"], "requires":["distributed.sharding"]},
    "runtime.task_graph": {"minimumStage":"guest-executed", "targets":["cpu","gpu","cluster"], "requires":[]},
    "runtime.energy_metrics": {"minimumStage":"physical-hardware", "targets":["cpu","gpu","embedded"], "requires":[]},
    "rt.bounded_allocation": {"minimumStage":"guest-executed", "targets":["cpu","embedded"], "requires":["memory.owned_views"]},
    "rt.temporal_isolation": {"minimumStage":"physical-hardware", "targets":["cpu","embedded"], "requires":["rt.bounded_allocation"]},
    "rt.deadline": {"minimumStage":"deadline-verified", "targets":["cpu","embedded"], "requires":["rt.bounded_allocation", "rt.temporal_isolation"]}
  }
}
